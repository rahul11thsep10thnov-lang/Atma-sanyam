# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example is a template with no real secrets in it and
# is meant to be committed (referenced from DEPLOYMENT.md and
# ENVIRONMENT_VARIABLES.md); every actual .env* file with real values
# stays ignored.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Local-disk document storage fallback (dev only — see
# src/lib/documents/storage.ts). Never committed; production uses real
# object storage via STORAGE_* env vars.
/public/uploads

# local output of npm run sources:verify
source-verification-report.md
