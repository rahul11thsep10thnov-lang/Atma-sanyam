# ---------------------------------------------------------------------------
# Exam Portal — copy to .env for local development. NEVER commit a real .env
# (it's already git-ignored). In production, set these in your host's
# dashboard (Vercel → Project → Settings → Environment Variables).
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Local Postgres example below; for Neon/
# Supabase/Render paste the URL they give you (include ?sslmode=require
# in production).
DATABASE_URL="postgresql://examportal:examportal-local-dev@localhost:5432/examportal_dev?schema=public"

# --- Authentication (Phase 3) -----------------------------------------------
# REQUIRED. Random 32+ byte secret used to sign session/JWT cookies.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Public URL this app is served from (no trailing slash). Required in
# production; NextAuth infers it from the request in local dev.
NEXTAUTH_URL=http://localhost:3000

# --- SEO (Phase 12) ----------------------------------------------------------
# Public site URL (no trailing slash) — used by the sitemap, robots.txt,
# canonical URLs, and JSON-LD. Defaults to http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Object storage for PDFs/images (Phase 13) ------------------------------
# Any S3-compatible provider (S3, R2, Supabase Storage, Backblaze B2...).
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

# --- AI document extraction (Phase 14) --------------------------------------
# Optional — defaults to "mock" (a deterministic stub, no external API
# calls) if unset. Any other value throws at extraction time until a real
# provider is implemented in src/lib/ai/provider.ts and added to
# getAIProvider() — it never silently falls back to mock data.
AI_EXTRACTION_PROVIDER=mock

# --- Automated notice pipeline (Automation Phases 3–4) ----------------------
# Claude-backed extraction is OPTIONAL. Without ANTHROPIC_API_KEY the
# pipeline runs the rule extractor only and routes everything it is not
# sure about to the admin review queue; nothing is ever auto-published
# from an unverified value either way.
ANTHROPIC_API_KEY=
# Model + effort used for extraction (defaults shown). Cost control: Claude
# is only consulted when the rules score below CLAUDE_TRIGGER_CONFIDENCE.
AI_EXTRACTION_MODEL=claude-opus-5-5
AI_EXTRACTION_EFFORT=medium
CLAUDE_TRIGGER_CONFIDENCE=0.9
# Hindi titles/summaries are generated by Claude for every new notice when
# the key is set (labelled "AI अनुवाद" on the site). Set to false to skip.
AI_TRANSLATION_ENABLED=true
AI_TRANSLATION_MODEL=
# Confidence engine thresholds (0–1). Official-domain notices at or above
# AUTO_PUBLISH_MIN_CONFIDENCE with no validation errors are auto-approved;
# REVIEW_MIN_CONFIDENCE and above go to review; below that they stay NEW.
AUTO_PUBLISH_MIN_CONFIDENCE=0.95
REVIEW_MIN_CONFIDENCE=0.8
# OCR for scanned PDFs/images (tesseract.js, eng+hin). Off by default
# because the first run downloads ~30 MB of language data.
OCR_ENABLED=false
# Scheduler: a cron that calls GET/POST /api/admin/pipeline/run with
# `Authorization: Bearer $CRON_SECRET` (vercel.json ships a 30-minute cron;
# Vercel injects this value automatically when the env var is set).
# Generate with: openssl rand -hex 32. Without it only signed-in admins
# can trigger runs, and `npm run pipeline:worker` still works.
CRON_SECRET=
# Minutes between passes for `npm run pipeline:worker` (default 15).
PIPELINE_INTERVAL_MINUTES=15

# --- Reader alerts (Automation Phase 10) ------------------------------------
# E-mail alerts use Resend's HTTP API (https://resend.com, no SDK). Both
# values are required for anything to be sent; without them subscriptions
# are stored and every delivery is recorded FAILED with the reason, and in
# development the subscribe form shows the confirmation link directly.
RESEND_API_KEY=
ALERTS_FROM_EMAIL="Naukri Chayan Alerts <alerts@yourdomain.in>"

# --- Notifications (Phase 16) -----------------------------------------------
# No provider is wired up for EMAIL/PUSH/TELEGRAM/WHATSAPP/ANDROID yet —
# see src/lib/notifications/dispatcher.ts. There's nothing to configure
# here until a real ChannelDispatcher is implemented for one of those
# channels; only WEBSITE (which needs no external config) actually sends
# today.

# --- Analytics (Phase 17) ---------------------------------------------------
# No configuration needed — analytics is first-party (src/lib/analytics/
# track.ts writes directly to this app's own database), not a third-party
# service.

# --- One-time seed scripts (not read by the app itself) ---------------------
# Used by `npm run seed:admin` to create the first SUPER_ADMIN. Remove from
# the environment after the first run.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=

# --- Reader accounts, membership, Felicitation Board ------------------------
# SMS for OTP codes and member job alerts. Pick one provider:
#   SMS_PROVIDER=msg91  → MSG91_AUTH_KEY, MSG91_OTP_TEMPLATE_ID (DLT Flow
#                         template with ##otp##), MSG91_ALERT_TEMPLATE_ID (##message##)
#   SMS_PROVIDER=twilio → TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM
# Without a provider, development shows the OTP on screen; production refuses.
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_ALERT_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Payments (membership ₹10/month + Felicitation Board listing) via Razorpay.
# Webhook URL: https://<your-domain>/api/payments/razorpay/webhook with events
# payment.captured, order.paid, payment.failed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Development only: PAYMENT_PROVIDER=mock simulates checkout (ignored in production).
PAYMENT_PROVIDER=
MEMBERSHIP_PRICE_RUPEES=10
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts the last four
# Aadhaar digits. REQUIRED in production; never change it once data exists.
IDENTITY_ENCRYPTION_KEY=
# Google AdSense (hidden for members). ads.txt is generated from the client id.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_JOB=
# App promotion block: Play Store link; screenshot goes in public/app-preview.png
NEXT_PUBLIC_APP_DOWNLOAD_URL=
