// Exam Portal — Prisma schema.
//
// Full normalized schema per DATABASE_SCHEMA.md. Exam is the central
// entity (Section 5): Job/Result/AdmitCard/AnswerKey/Syllabus each belong
// to exactly one Exam via a foreign key rather than duplicating data.
//
// Shared content fields (Section 4) — id, title, slug, description,
// status, createdAt, updatedAt, publishedAt, createdBy, updatedBy — are
// repeated on every publishable model (Prisma has no field mixins).
// `createdBy`/`updatedBy` are plain `AdminUser.id` strings, not enforced
// foreign keys: they're an audit trail, not something we want to block a
// content delete/restore on, or that forces AdminUser to carry a dozen
// reverse-relation arrays, one per content type.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Role-based access control for the admin CMS (Section 16). Enforced
/// server-side on every admin route/action, not just hidden in the UI.
enum AdminRole {
  SUPER_ADMIN
  EDITOR
  AUTHOR
  REVIEWER
}

/// Editorial workflow status shared by every publishable content type
/// (Section 17). AI-extracted content always starts at DRAFT/IN_REVIEW and
/// can never reach PUBLISHED without a human APPROVE action.
enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
  REJECTED
}

/// What kind of official document was uploaded (Section 19/21A Step 1).
enum DocumentType {
  JOB_NOTIFICATION
  RESULT
  ADMIT_CARD
  ANSWER_KEY
  SYLLABUS
  ADMISSION
  SCHOLARSHIP
  OTHER
}

/// A PDF upload is never assumed authentic just because it was uploaded
/// (Section 19) — an admin must mark it verified, ideally against a
/// recorded official source URL.
enum DocumentVerificationStatus {
  UNVERIFIED
  VERIFIED
}

/// Pipeline status tracked per document (Section 21A Step 14).
enum ExtractionStatus {
  UPLOADED
  EXTRACTING
  EXTRACTED
  CLASSIFIED
  AI_PROCESSING
  VALIDATION_FAILED
  READY_FOR_REVIEW
  UNDER_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  ARCHIVED
  FAILED
}

/// Admin audit trail action types (Section 27).
enum AuditAction {
  LOGIN
  CREATE
  UPDATE
  DELETE
  PUBLISH
  UNPUBLISH
  APPROVE
  REJECT
  UPLOAD
  DOWNLOAD
}

/// Notification event types (Section 28 / 21A Step 12).
enum NotificationType {
  NEW_JOB
  NEW_RESULT
  NEW_ADMIT_CARD
  NEW_ANSWER_KEY
  NEW_EXAM_NOTIFICATION
  ANSWER_KEY_RELEASED
  EXAM_DATE_CHANGED
  DEADLINE_UPDATE
  APPLICATION_DEADLINE
}

/// Delivery channel abstraction (Section 28) — the core Notification row
/// stays provider-agnostic; fan-out per channel is tracked separately.
enum NotificationChannel {
  WEBSITE
  EMAIL
  PUSH
  TELEGRAM
  WHATSAPP
  ANDROID
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum ContactMessageStatus {
  NEW
  RESOLVED
}

// --- Automated notification pipeline (see AUTOMATION_ASSESSMENT.md) -------

enum SourceType {
  ATOM
  HTML
  PDF
  RSS
  API
  SITEMAP
  JSON
  XML
}

/// Registry grouping (spec: source categories A–G, plus public aggregators).
enum SourceCategory {
  CENTRAL
  BANKING
  RAILWAY
  STATE
  DEFENCE
  EDUCATION
  OTHER_GOVT
  AGGREGATOR
}

/// Discovered / seeded sources wait for an admin before they can be enabled.
enum SourceApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Whether the URL was checked to be reachable, on the intended domain and parseable.
enum SourceVerificationStatus {
  UNVERIFIED
  VERIFIED
  FAILED
}

enum SourcePriority {
  HIGH
  NORMAL
  LOW
}

enum OrganizationType {
  CENTRAL
  STATE
  PSU
  UNIVERSITY
  COURT
  DEFENCE
  MUNICIPAL
  AUTONOMOUS
  OTHER
}

/// What a single government notice is about. One recruitment accumulates
/// many of these over its lifecycle.
enum NoticeType {
  JOB
  ADMIT_CARD
  EXAM_DATE
  ANSWER_KEY
  RESULT
  MERIT_LIST
  SELECTION_LIST
  INTERVIEW
  DOCUMENT_VERIFICATION
  CORRIGENDUM
  DEADLINE_EXTENSION
  EXAM_POSTPONED
  EXAM_CANCELLED
  APPLICATION_STARTED
  CORRECTION_WINDOW
  OTHER
}

enum NoticeStatus {
  NEW
  NEEDS_REVIEW
  AUTO_APPROVED
  APPROVED
  REJECTED
  PUBLISHED
  DUPLICATE
  FAILED
}

enum NoticePriority {
  URGENT
  HIGH
  NORMAL
  LOW
}

enum PipelineRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum PipelineTrigger {
  CRON
  MANUAL
  SOURCE_CHECK
  RETRY
}

enum PipelineErrorType {
  FETCH
  PARSE
  OCR
  EXTRACTION
  RESOLUTION
  VALIDATION
  PUBLISH
  UNKNOWN
}

// ---------------------------------------------------------------------------
// Users & access
// ---------------------------------------------------------------------------

/// Admin/CMS user account.
model AdminUser {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  passwordHash     String
  role             AdminRole @default(AUTHOR)
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  /// Consecutive failed sign-in attempts since the last success; reset to 0
  /// on success. At 5 the account is locked for 15 minutes (Section 26).
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  auditLogs AuditLog[]

  @@index([role])
  @@map("admin_users")
}

/// Public site visitor account (saved searches, notification subscriptions).
/// Browsing/searching the site never requires an account — this is only
/// for opt-in features added in a later phase.

// ---------------------------------------------------------------------------
// Lookups shared across content types
// ---------------------------------------------------------------------------

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  website     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Canonical record fields filled by the pipeline's entity resolver
  /// (Phase 5); all optional so existing rows are untouched.
  shortName        String?
  organizationType OrganizationType?
  stateId          String?
  state            State?            @relation(fields: [stateId], references: [id])
  parentId         String?
  parent           Organization?     @relation("OrganizationHierarchy", fields: [parentId], references: [id])
  children         Organization[]    @relation("OrganizationHierarchy")
  isAutoCreated    Boolean           @default(false)

  exams        Exam[]
  jobs         Job[]
  admissions   Admission[]
  scholarships Scholarship[]
  documents    Document[]
  aliases      OrganizationAlias[]
  recruitments Recruitment[]
  sources      Source[]
  notices      RecruitmentNotice[]

  alertSubscriptions AlertSubscription[]

  @@index([name])
  @@index([stateId])
  @@index([parentId])
  @@map("organizations")
}

model Category {
  id            String     @id @default(cuid())
  name          String
  slug          String     @unique
  description   String?
  parentId      String?
  parent        Category?  @relation("CategoryToParent", fields: [parentId], references: [id])
  children      Category[] @relation("CategoryToParent")
  isAutoCreated Boolean    @default(false)

  exams                 Exam[]
  admissions            Admission[]
  recruitmentCategories RecruitmentCategory[]

  alertSubscriptions AlertSubscription[]

  @@index([parentId])
  @@map("categories")
}

/// 28 states + 8 union territories + a synthetic "ALL_INDIA" row for
/// national-level exams. Seeded in Phase 2's seed script.
model State {
  id   String @id @default(cuid())
  name String
  code String @unique
  slug String @unique

  exams         Exam[]
  admissions    Admission[]
  scholarships  Scholarship[]
  organizations Organization[]

  alertSubscriptions AlertSubscription[]

  @@map("states")
}

model Tag {
  id   String @id @default(cuid())
  name String
  slug String @unique

  examTags ExamTag[]

  @@map("tags")
}

// ---------------------------------------------------------------------------
// Exam — the central entity (Section 5)
// ---------------------------------------------------------------------------

model Exam {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?
  createdBy   String
  updatedBy   String

  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id])
  categoryId           String
  category             Category     @relation(fields: [categoryId], references: [id])
  stateId              String?
  state                State?       @relation(fields: [stateId], references: [id])
  examDate             DateTime?
  applicationStartDate DateTime?
  applicationEndDate   DateTime?
  isAutoCreated        Boolean      @default(false)

  jobs           Job[]
  results        Result[]
  admitCards     AdmitCard[]
  answerKeys     AnswerKey[]
  syllabi        Syllabus[]
  importantLinks ImportantLink[]
  examTags       ExamTag[]
  documents      Document[]
  aliases        ExamAlias[]
  recruitments   Recruitment[]
  notices        RecruitmentNotice[]

  felicitations FelicitationEntry[]

  @@index([organizationId])
  @@index([categoryId])
  @@index([stateId])
  @@index([status])
  @@index([publishedAt])
  @@index([applicationEndDate])
  @@map("exams")
}

model ExamTag {
  id     String @id @default(cuid())
  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([examId, tagId])
  @@map("exam_tags")
}

// ---------------------------------------------------------------------------
// Content types — each belongs to exactly one Exam
// ---------------------------------------------------------------------------

model Job {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?
  createdBy   String
  updatedBy   String

  examId String
  exam   Exam   @relation(fields: [examId], references: [id])

  /// Denormalized from exam.organizationId for fast organization-page
  /// listings without joining through Exam.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  advertisementNumber      String?
  vacancies                Int?
  qualification            String?
  ageLimitMin              Int?
  ageLimitMax              Int?
  /// Headline fee amount; a per-category breakdown (General/OBC/SC/ST/PwD…)
  /// lives in applicationFeeByCategory since it varies by notification.
  applicationFee           Decimal?  @db.Decimal(10, 2)
  applicationFeeByCategory Json?
  /// [{ name, eligibility, vacancies }] — post-wise table on the job page.
  posts                    Json?
  /// [{ label, date }] — free-form important dates (ISO or text).
  importantDates           Json?
  /// Short "broad eligibility" text shown beside the dates.
  examPatternUrl           String?
  syllabusUrl              String?
  notificationDocumentId   String?
  notificationDocument     Document? @relation(fields: [notificationDocumentId], references: [id])
  officialWebsite          String?
  applyUrl                 String?
  eligibility              String?
  /// Ordered list of selection stages, e.g. ["Tier 1", "Tier 2", "Interview"].
  selectionProcess         Json?
  examPattern              Json?
  salary                   String?
  applicationEndDate       DateTime?
  seoTitle                 String?
  seoDescription           String?
  seoKeywords              String[]

  importantLinks ImportantLink[]

  recruitmentId String?
  recruitment   Recruitment? @relation(fields: [recruitmentId], references: [id])

  @@index([examId])
  @@index([organizationId])
  @@index([recruitmentId])
  @@index([status])
  @@index([publishedAt])
  @@index([applicationEndDate])
  @@map("jobs")
}

model Result {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?
  createdBy   String
  updatedBy   String

  examId String
  exam   Exam   @relation(fields: [examId], references: [id])

  resultDate         DateTime?
  resultUrl          String?
  officialWebsite    String?
  relatedAdmitCardId String?
  relatedAdmitCard   AdmitCard? @relation(fields: [relatedAdmitCardId], references: [id])
  relatedAnswerKeyId String?
  relatedAnswerKey   AnswerKey? @relation(fields: [relatedAnswerKeyId], references: [id])

  recruitmentId String?
  recruitment   Recruitment? @relation(fields: [recruitmentId], references: [id])

  @@index([examId])
  @@index([recruitmentId])
  @@index([status])
  @@index([publishedAt])
  @@index([resultDate])
  @@map("results")
}

model AdmitCard {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?
  createdBy   String
  updatedBy   String

  examId String
  exam   Exam   @relation(fields: [examId], references: [id])

  releaseDate     DateTime?
  examDate        DateTime?
  downloadUrl     String?
  officialWebsite String?
  instructions    String?

  results Result[]

  recruitmentId String?
  recruitment   Recruitment? @relation(fields: [recruitmentId], references: [id])

  @@index([examId])
  @@index([recruitmentId])
  @@index([status])
  @@index([publishedAt])
  @@index([examDate])
  @@map("admit_cards")
}

model AnswerKey {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?
  createdBy   String
  updatedBy   String

  examId String
  exam   Exam   @relation(fields: [examId], references: [id])

  answerKeyDate     DateTime?
  answerKeyUrl      String?
  objectionDeadline DateTime?
  objectionInfo     String?

  results Result[]

  recruitmentId String?
  recruitment   Recruitment? @relation(fields: [recruitmentId], references: [id])

  @@index([examId])
  @@index([recruitmentId])
  @@index([status])
  @@index([publishedAt])
  @@map("answer_keys")
}

/// Structured syllabus (Section 13): Syllabus → Paper → Subject → Topic,
/// rather than one giant text blob.
model Syllabus {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?
  createdBy   String
  updatedBy   String

  examId String
  exam   Exam   @relation(fields: [examId], references: [id])

  papers SyllabusPaper[]

  @@index([examId])
  @@index([status])
  @@index([publishedAt])
  @@map("syllabi")
}

model SyllabusPaper {
  id         String   @id @default(cuid())
  syllabusId String
  syllabus   Syllabus @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  name       String
  order      Int      @default(0)

  subjects SyllabusSubject[]

  @@index([syllabusId])
  @@map("syllabus_papers")
}

model SyllabusSubject {
  id      String        @id @default(cuid())
  paperId String
  paper   SyllabusPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  name    String
  order   Int           @default(0)

  topics SyllabusTopic[]

  @@index([paperId])
  @@map("syllabus_subjects")
}

model SyllabusTopic {
  id        String          @id @default(cuid())
  subjectId String
  subject   SyllabusSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name      String
  subtopics String[]
  order     Int             @default(0)

  @@index([subjectId])
  @@map("syllabus_topics")
}

// ---------------------------------------------------------------------------
// Standalone content types (not exam-scoped)
// ---------------------------------------------------------------------------

model Admission {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?
  createdBy   String
  updatedBy   String

  organizationId       String?
  organization         Organization? @relation(fields: [organizationId], references: [id])
  categoryId           String?
  category             Category?     @relation(fields: [categoryId], references: [id])
  stateId              String?
  state                State?        @relation(fields: [stateId], references: [id])
  applicationStartDate DateTime?
  applicationEndDate   DateTime?
  eligibility          String?
  officialWebsite      String?

  @@index([organizationId])
  @@index([categoryId])
  @@index([stateId])
  @@index([status])
  @@index([publishedAt])
  @@index([applicationEndDate])
  @@map("admissions")
}

model Scholarship {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?
  createdBy   String
  updatedBy   String

  organizationId     String?
  organization       Organization? @relation(fields: [organizationId], references: [id])
  stateId            String?
  state              State?        @relation(fields: [stateId], references: [id])
  applicationEndDate DateTime?
  eligibility        String?
  amount             String?
  officialWebsite    String?

  @@index([organizationId])
  @@index([stateId])
  @@index([status])
  @@index([publishedAt])
  @@index([applicationEndDate])
  @@map("scholarships")
}

model Article {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?
  createdBy   String
  updatedBy   String

  body          String
  authorId      String
  coverImageUrl String?

  @@index([status])
  @@index([publishedAt])
  @@map("articles")
}

// ---------------------------------------------------------------------------
// Cross-cutting
// ---------------------------------------------------------------------------

/// Generic "Apply Online / Download Notification / Official Website" links
/// attached to an Exam or a Job.
model ImportantLink {
  id     String  @id @default(cuid())
  label  String
  url    String
  order  Int     @default(0)
  examId String?
  exam   Exam?   @relation(fields: [examId], references: [id], onDelete: Cascade)
  jobId  String?
  job    Job?    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([jobId])
  @@map("important_links")
}

/// Polymorphic related-content links (Section 21A Step 8), populated by a
/// service using real database relationships (shared exam/organization/
/// category), never plain keyword matching. `sourceType`/`targetType` are
/// content-type discriminators, e.g. "Exam", "Job", "Result", "Article".
model RelatedContent {
  id            String   @id @default(cuid())
  sourceType    String
  sourceId      String
  targetType    String
  targetId      String
  relationScore Float?
  createdAt     DateTime @default(now())

  @@unique([sourceType, sourceId, targetType, targetId])
  @@index([sourceType, sourceId])
  @@map("related_content")
}

model Notification {
  id         String           @id @default(cuid())
  type       NotificationType
  title      String
  body       String
  targetType String?
  targetId   String?
  priority   NoticePriority   @default(NORMAL)
  createdAt  DateTime         @default(now())
  sentAt     DateTime?

  recruitmentNoticeId String?
  recruitmentNotice   RecruitmentNotice? @relation(fields: [recruitmentNoticeId], references: [id])

  deliveries NotificationDelivery[]

  alertDeliveries AlertDelivery[]

  @@index([type])
  @@index([createdAt])
  @@index([recruitmentNoticeId])
  @@map("notifications")
}

/// Per-channel fan-out so the core Notification row never couples to one
/// provider (Section 28).
model NotificationDelivery {
  id             String                     @id @default(cuid())
  notificationId String
  notification   Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(PENDING)
  error          String?
  sentAt         DateTime?

  @@index([notificationId])
  @@index([channel, status])
  @@map("notification_deliveries")
}

/// Every important admin action (Section 27).
model AuditLog {
  id            String      @id @default(cuid())
  /// Null for automated pipeline actions; `actor` then names the system
  /// ("pipeline") so "Approved by: AUTO" is a real, queryable fact.
  adminUserId   String?
  adminUser     AdminUser?  @relation(fields: [adminUserId], references: [id])
  actor         String?
  action        AuditAction
  contentType   String?
  contentId     String?
  previousValue Json?
  newValue      Json?
  createdAt     DateTime    @default(now())

  @@index([adminUserId])
  @@index([contentType, contentId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ContactMessage {
  id        String               @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now())

  @@index([status])
  @@map("contact_messages")
}

// ---------------------------------------------------------------------------
// Documents & AI extraction pipeline (Sections 19–21A)
// ---------------------------------------------------------------------------

model Document {
  id                 String                     @id @default(cuid())
  filename           String
  documentType       DocumentType
  examId             String?
  exam               Exam?                      @relation(fields: [examId], references: [id])
  organizationId     String?
  organization       Organization?              @relation(fields: [organizationId], references: [id])
  storageUrl         String
  sourceUrl          String?
  checksum           String
  /// Null when the pipeline fetched the file (no admin involved).
  uploadedBy         String?
  uploadedAt         DateTime                   @default(now())
  verificationStatus DocumentVerificationStatus @default(UNVERIFIED)

  /// Pipeline provenance + extracted content (Phase 3). The original file
  /// is never modified; a changed hash becomes a new DocumentVersion.
  sourceId          String?
  source            Source?   @relation(fields: [sourceId], references: [id])
  mimeType          String?
  fileSize          Int?
  pageCount         Int?
  extractedText     String?
  ocrUsed           Boolean   @default(false)
  sourcePublishedAt DateTime?
  lastFetchedAt     DateTime?

  extractionJobs        ExtractionJob[]
  jobsUsingNotification Job[]
  versions              DocumentVersion[]
  notices               RecruitmentNotice[]
  errors                PipelineError[]

  @@index([examId])
  @@index([organizationId])
  @@index([documentType])
  @@index([sourceId])
  @@index([checksum])
  @@map("documents")
}

/// Tracks a document through the pipeline (Section 21A Steps 14–15).
/// `(documentId, attempt)` is unique so a retry never creates a duplicate
/// job — it increments `attempt` on the same document instead.
model ExtractionJob {
  id         String           @id @default(cuid())
  documentId String
  document   Document         @relation(fields: [documentId], references: [id])
  status     ExtractionStatus @default(UPLOADED)
  attempt    Int              @default(1)
  aiModel    String?
  error      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  results ExtractionResult[]

  @@unique([documentId, attempt])
  @@index([status])
  @@map("extraction_jobs")
}

/// One row per extracted field (Section 3/21A Step 3), so a field can be
/// individually accepted, edited, rejected, or flagged uncertain without
/// touching the rest of the extraction.
model ExtractionResult {
  id              String        @id @default(cuid())
  extractionJobId String
  extractionJob   ExtractionJob @relation(fields: [extractionJobId], references: [id], onDelete: Cascade)
  fieldPath       String
  value           Json?
  sourcePage      Int?
  confidence      Float?
  isUncertain     Boolean       @default(false)
  conflictsWith   Json?

  overrides FieldOverride[]

  @@index([extractionJobId])
  @@map("extraction_results")
}

/// Human-approved data always wins over AI output (Section 17). Recorded
/// as an override rather than an in-place edit so both values stay
/// auditable.
model FieldOverride {
  id                 String           @id @default(cuid())
  extractionResultId String
  extractionResult   ExtractionResult @relation(fields: [extractionResultId], references: [id], onDelete: Cascade)
  aiValue            Json?
  humanValue         Json
  adminUserId        String
  reason             String?
  createdAt          DateTime         @default(now())

  @@index([extractionResultId])
  @@map("field_overrides")
}

/// A published record's history (Section 21A Step 16) — updating an
/// already-published notification creates a new version instead of
/// silently overwriting the previous one.
model ContentVersion {
  id            String   @id @default(cuid())
  contentType   String
  contentId     String
  versionNumber Int
  snapshot      Json
  createdBy     String
  createdAt     DateTime @default(now())
  changeSummary String?

  @@unique([contentType, contentId, versionNumber])
  @@index([contentType, contentId])
  @@map("content_versions")
}

// ---------------------------------------------------------------------------
// Analytics (Phase 17) — privacy-conscious by construction: no IP address,
// no user agent, no cookie/session id, no full referrer URL (only a
// hostname). A view is just "this content was looked at, once, at this
// time" — enough to rank popular content, not enough to reconstruct who
// looked at it.
// ---------------------------------------------------------------------------

model ContentViewEvent {
  id           String   @id @default(cuid())
  contentType  String
  contentId    String
  path         String
  referrerHost String?
  createdAt    DateTime @default(now())

  @@index([contentType, contentId])
  @@index([createdAt])
  @@map("content_view_events")
}

// ---------------------------------------------------------------------------
// Automated government-notification pipeline (AUTOMATION_ASSESSMENT.md).
// Recruitment is the central object; every notice hangs off it.
// ---------------------------------------------------------------------------

/// Alternate names an organization is known by (UPPRPB / U.P. Police
/// Recruitment and Promotion Board / UP Police Recruitment Board …).
/// `normalized` is the lowercase alphanumeric key the resolver matches on.
model OrganizationAlias {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  alias          String
  normalized     String       @unique
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("organization_aliases")
}

model ExamAlias {
  id         String   @id @default(cuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  alias      String
  normalized String   @unique
  createdAt  DateTime @default(now())

  @@index([examId])
  @@map("exam_aliases")
}

/// One recruitment drive (e.g. "UP Police Constable Recruitment 2027").
/// The job advertisement, deadline extensions, admit card, answer key,
/// result and document verification are all notices on this one row, so
/// the public site shows a single lifecycle instead of N unrelated entries.
model Recruitment {
  id                   String        @id @default(cuid())
  title                String
  titleHi              String?
  slug                 String        @unique
  summary              String?
  summaryHi            String?
  /// Who produced titleHi/summaryHi: "claude" (machine, labelled as such
  /// on the site) or "admin" (human). Null = no Hindi text.
  translationSource    String?
  year                 Int?
  status               ContentStatus @default(DRAFT)
  publishedAt          DateTime?
  applicationStartDate DateTime?
  applicationEndDate   DateTime?
  examDate             DateTime?
  isAutoCreated        Boolean       @default(false)
  createdBy            String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  examId         String?
  exam           Exam?        @relation(fields: [examId], references: [id])

  categories RecruitmentCategory[]
  notices    RecruitmentNotice[]
  jobs       Job[]
  results    Result[]
  admitCards AdmitCard[]
  answerKeys AnswerKey[]

  alertSubscriptions AlertSubscription[]

  @@index([organizationId])
  @@index([examId])
  @@index([status])
  @@index([publishedAt])
  @@index([applicationEndDate])
  @@map("recruitments")
}

/// A recruitment belongs to many categories (Police + State Government +
/// 10+2 + Uniformed Services) — never forced into one.
model RecruitmentCategory {
  recruitmentId String
  recruitment   Recruitment @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isPrimary     Boolean     @default(false)

  @@id([recruitmentId, categoryId])
  @@index([categoryId])
  @@map("recruitment_categories")
}

/// An official page/feed the pipeline watches. etag/lastModified/
/// lastContentHash make re-checks cheap (HTTP caching + change detection).
model Source {
  id                    String                   @id @default(cuid())
  name                  String
  organizationId        String?
  organization          Organization?            @relation(fields: [organizationId], references: [id])
  officialDomain        String
  listingUrl            String                   @unique
  sourceType            SourceType               @default(HTML)
  rssUrl                String?
  apiUrl                String?
  parserType            String?
  priority              SourcePriority           @default(NORMAL)
  checkFrequencyMinutes Int                      @default(360)
  active                Boolean                  @default(true)
  robotsStatus          String?
  etag                  String?
  lastModified          String?
  lastContentHash       String?
  lastCheckedAt         DateTime?
  lastSuccessAt         DateTime?
  lastError             String?
  discoveredCount       Int                      @default(0)
  failureCount          Int                      @default(0)
  /// Normalised listing URL; one source record per canonical URL.
  canonicalUrl          String?                  @unique
  category              SourceCategory           @default(CENTRAL)
  /// ISO 3166-2:IN subdivision code without the "IN-" prefix (UP, BR, DL…).
  stateCode             String?
  /// Free-text group ("RRB", "UP Recruitment", …) for bulk handling.
  groupName             String?
  isAggregator          Boolean                  @default(false)
  requestTimeoutMs      Int                      @default(20000)
  /// Minimum gap between two requests to this source's host.
  minRequestIntervalMs  Int                      @default(1500)
  parserConfig          Json?
  paginationConfig      Json?
  approvalStatus        SourceApprovalStatus     @default(APPROVED)
  verificationStatus    SourceVerificationStatus @default(UNVERIFIED)
  verificationNote      String?
  lastVerifiedAt        DateTime?
  lastExtractionAt      DateTime?
  lastHttpStatus        Int?
  lastDurationMs        Int?
  /// OK | NOT_MODIFIED | UNCHANGED | EMPTY | PARSE_ERROR | HTTP_ERROR | BLOCKED | RATE_LIMITED | NETWORK | ROBOTS | INVALID_URL
  lastOutcome           String?
  consecutiveFailures   Int                      @default(0)
  noticesInserted       Int                      @default(0)
  nextCheckAt           DateTime?
  /// Set after a 403/401/451 or a long Retry-After; the scheduler skips the source until then.
  blockedUntil          DateTime?
  lockedUntil           DateTime?
  lockedBy              String?
  alertedAt             DateTime?
  discoveredFromId      String?
  discoveredFrom        Source?                  @relation("SourceDiscovery", fields: [discoveredFromId], references: [id], onDelete: SetNull)
  discovered            Source[]                 @relation("SourceDiscovery")
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  checks    SourceCheck[]
  documents Document[]
  notices   RecruitmentNotice[]
  errors    PipelineError[]

  @@index([organizationId])
  @@index([active, priority])
  @@index([category, stateCode])
  @@index([approvalStatus])
  @@index([active, nextCheckAt])
  @@index([groupName])
  @@map("sources")
}

model SourceCheck {
  id                String       @id @default(cuid())
  sourceId          String
  source            Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  pipelineRunId     String?
  pipelineRun       PipelineRun? @relation(fields: [pipelineRunId], references: [id])
  startedAt         DateTime     @default(now())
  finishedAt        DateTime?
  ok                Boolean      @default(false)
  httpStatus        Int?
  changed           Boolean      @default(false)
  itemsFound        Int          @default(0)
  newItems          Int          @default(0)
  error             String?
  outcome           String?
  durationMs        Int?
  pagesFetched      Int          @default(0)
  noticesExtracted  Int          @default(0)
  duplicatesSkipped Int          @default(0)
  /// Bounded (a few KB) per-check diagnostics: final URL, redirects, page list, warnings.
  diagnostics       Json?

  @@index([sourceId, startedAt])
  @@index([pipelineRunId])
  @@map("source_checks")
}

model PipelineRun {
  id             String            @id @default(cuid())
  trigger        PipelineTrigger   @default(MANUAL)
  status         PipelineRunStatus @default(RUNNING)
  startedAt      DateTime          @default(now())
  finishedAt     DateTime?
  sourcesChecked Int               @default(0)
  pagesScanned   Int               @default(0)
  newDocuments   Int               @default(0)
  newNotices     Int               @default(0)
  updatedNotices Int               @default(0)
  duplicates     Int               @default(0)
  needsReview    Int               @default(0)
  autoPublished  Int               @default(0)
  failures       Int               @default(0)
  log            Json?

  checks SourceCheck[]
  errors PipelineError[]

  @@index([startedAt])
  @@map("pipeline_runs")
}

/// Dead-letter queue: anything that fails lands here with an exponential
/// retry schedule instead of crashing the run.
model PipelineError {
  id            String             @id @default(cuid())
  pipelineRunId String?
  pipelineRun   PipelineRun?       @relation(fields: [pipelineRunId], references: [id])
  sourceId      String?
  source        Source?            @relation(fields: [sourceId], references: [id])
  documentId    String?
  document      Document?          @relation(fields: [documentId], references: [id])
  noticeId      String?
  notice        RecruitmentNotice? @relation(fields: [noticeId], references: [id])
  errorType     PipelineErrorType  @default(UNKNOWN)
  message       String
  payload       Json?
  retryCount    Int                @default(0)
  lastAttemptAt DateTime           @default(now())
  nextRetryAt   DateTime?
  resolvedAt    DateTime?

  @@index([resolvedAt, nextRetryAt])
  @@index([sourceId])
  @@map("pipeline_errors")
}

/// Every distinct version of a fetched document. A changed hash never
/// overwrites — it adds a version, and `diff` drives UPDATE notices.
model DocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber Int
  checksum      String
  storageUrl    String
  extractedText String?
  pageCount     Int?
  ocrUsed       Boolean  @default(false)
  fetchedAt     DateTime @default(now())
  diff          Json?

  notices RecruitmentNotice[]

  @@unique([documentId, versionNumber])
  @@index([checksum])
  @@map("document_versions")
}

/// One government notice — the spec's universal "Notification", named
/// RecruitmentNotice so it never collides with the outbound-alert
/// `Notification` model. `extracted` holds structured JSON with per-field
/// provenance; `publishedContentType/Id` point at the Job/Result/
/// AdmitCard/AnswerKey row created when it was published.
model RecruitmentNotice {
  id                   String         @id @default(cuid())
  noticeType           NoticeType     @default(OTHER)
  status               NoticeStatus   @default(NEW)
  priority             NoticePriority @default(NORMAL)
  title                String
  titleHi              String?
  summary              String?
  summaryHi            String?
  translationSource    String?
  slug                 String?        @unique
  sourceUrl            String?
  canonicalUrl         String?
  sourceDomain         String?
  sourcePublishedAt    DateTime?
  /// Website sections this notice belongs to (one notice, many sections).
  sections             String[]       @default([])
  stateCode            String?
  /// Set when found through a public aggregator: the aggregator page it came from.
  discoveredViaUrl     String?
  extracted            Json?
  overallConfidence    Float?
  fieldConfidence      Json?
  validationErrors     Json?
  changeSummary        Json?
  publishedAt          DateTime?
  publishedContentType String?
  publishedContentId   String?
  reviewedBy           String?
  reviewedAt           DateTime?
  reviewNote           String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  recruitmentId     String?
  recruitment       Recruitment?        @relation(fields: [recruitmentId], references: [id])
  organizationId    String?
  organization      Organization?       @relation(fields: [organizationId], references: [id])
  examId            String?
  exam              Exam?               @relation(fields: [examId], references: [id])
  sourceId          String?
  source            Source?             @relation(fields: [sourceId], references: [id])
  documentId        String?
  document          Document?           @relation(fields: [documentId], references: [id])
  documentVersionId String?
  documentVersion   DocumentVersion?    @relation(fields: [documentVersionId], references: [id])
  duplicateOfId     String?
  duplicateOf       RecruitmentNotice?  @relation("NoticeDuplicates", fields: [duplicateOfId], references: [id])
  duplicates        RecruitmentNotice[] @relation("NoticeDuplicates")

  alerts Notification[]
  errors PipelineError[]

  alertDeliveries AlertDelivery[]

  @@index([status])
  @@index([noticeType])
  @@index([recruitmentId])
  @@index([organizationId])
  @@index([sourceUrl])
  @@index([canonicalUrl])
  @@index([createdAt])
  @@index([sections], type: Gin)
  @@index([stateCode])
  @@index([sourceId, sourcePublishedAt])
  @@index([sourcePublishedAt])
  @@map("recruitment_notices")
}

/// Small key/value store for operational switches the admin flips at
/// runtime (pipeline paused, …) — no redeploy, no env edit.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("app_settings")
}

/// A reader's standing request for alerts (spec §23): e-mail, a scope
/// (one recruitment / organization / category / state, or a keyword, or
/// everything), the notice types they care about and a minimum priority.
/// Double opt-in: nothing is sent until `verifiedAt` is set.
model AlertSubscription {
  id               String              @id @default(cuid())
  email            String
  channel          NotificationChannel @default(EMAIL)
  recruitmentId    String?
  recruitment      Recruitment?        @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)
  organizationId   String?
  organization     Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId       String?
  category         Category?           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  stateId          String?
  state            State?              @relation(fields: [stateId], references: [id], onDelete: Cascade)
  keyword          String?
  noticeTypes      NoticeType[]
  minPriority      NoticePriority      @default(LOW)
  locale           String              @default("en")
  verifiedAt       DateTime?
  verifyToken      String              @unique
  unsubscribeToken String              @unique
  active           Boolean             @default(true)
  createdAt        DateTime            @default(now())
  lastNotifiedAt   DateTime?

  deliveries AlertDelivery[]

  @@index([email])
  @@index([active, verifiedAt])
  @@index([recruitmentId])
  @@index([organizationId])
  @@index([categoryId])
  @@map("alert_subscriptions")
}

/// One alert actually matched to one subscriber: the audit trail of who
/// was told what, and whether the e-mail went out.
model AlertDelivery {
  id                  String                     @id @default(cuid())
  subscriptionId      String
  subscription        AlertSubscription          @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  notificationId      String?
  notification        Notification?              @relation(fields: [notificationId], references: [id])
  recruitmentNoticeId String?
  recruitmentNotice   RecruitmentNotice?         @relation(fields: [recruitmentNoticeId], references: [id])
  channel             NotificationChannel        @default(EMAIL)
  status              NotificationDeliveryStatus @default(PENDING)
  error               String?
  createdAt           DateTime                   @default(now())
  sentAt              DateTime?

  @@unique([subscriptionId, recruitmentNoticeId])
  @@index([status, createdAt])
  @@map("alert_deliveries")
}

// ---------------------------------------------------------------------------
// Reader accounts (mobile + OTP + password), membership and payments
// ---------------------------------------------------------------------------

enum OtpPurpose {
  SIGNUP
  LOGIN
  RESET
  FELICITATION
}

enum PaymentPurpose {
  MEMBERSHIP
  FELICITATION
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
}

/// A website reader (not an admin). Identified by an OTP-verified Indian
/// mobile number in E.164 form (+91XXXXXXXXXX).
model User {
  id                 String    @id @default(cuid())
  /// Legacy columns from the original placeholder model, kept nullable.
  email              String?   @unique
  name               String?
  mobile             String    @unique
  passwordHash       String?
  mobileVerifiedAt   DateTime?
  fullName           String?
  age                Int?
  qualification      String?
  examsAimed         String[]
  profileCompletedAt DateTime?
  membershipUntil    DateTime?
  smsAlerts          Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions      UserSession[]
  payments      Payment[]
  felicitations FelicitationEntry[]
  smsLogs       SmsLog[]

  @@index([membershipUntil])
  @@index([createdAt])
  @@map("users")
}

/// Opaque session cookie → only the SHA-256 of the token is stored.
model UserSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

/// One-time codes are stored hashed, expire after a few minutes and allow
/// a bounded number of attempts.
model OtpCode {
  id         String     @id @default(cuid())
  mobile     String
  purpose    OtpPurpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime   @default(now())

  @@index([mobile, purpose, createdAt])
  @@index([ip, createdAt])
  @@map("otp_codes")
}

/// Every payment the site takes (membership, felicitation listing), one
/// row per provider order. Only a server-side verified signature/webhook
/// may move it to PAID.
model Payment {
  id                  String             @id @default(cuid())
  provider            String
  purpose             PaymentPurpose
  orderId             String             @unique
  paymentId           String?            @unique
  amountPaise         Int
  currency            String             @default("INR")
  status              PaymentStatus      @default(CREATED)
  failureReason       String?
  userId              String?
  user                User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  felicitationEntryId String?
  felicitationEntry   FelicitationEntry? @relation(fields: [felicitationEntryId], references: [id], onDelete: SetNull)
  paidAt              DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([userId])
  @@index([felicitationEntryId])
  @@map("payments")
}

/// Outbound SMS log (OTP codes are never written here — only the purpose).
model SmsLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  mobile    String
  purpose   String
  status    String
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("sms_logs")
}

// ---------------------------------------------------------------------------
// Felicitation Board
// ---------------------------------------------------------------------------

enum FelicitationStatus {
  DRAFT
  PAYMENT_PENDING
  PAYMENT_FAILED
  PAID_PENDING_APPROVAL
  APPROVED
  REJECTED
  SCHEDULED
  BROADCASTING
  PAUSED
  EXPIRED
}

model FelicitationEntry {
  id                String             @id @default(cuid())
  refCode           String             @unique
  candidateName     String
  locality          String
  city              String
  state             String
  examName          String
  examId            String?
  exam              Exam?              @relation(fields: [examId], references: [id], onDelete: SetNull)
  /// Private: never returned by public APIs.
  mobile            String
  userId            String?
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// AES-256-GCM ciphertext of the last four Aadhaar digits only.
  identityLast4Enc  String?
  identityConsentAt DateTime
  identityPurgedAt  DateTime?
  status            FelicitationStatus @default(DRAFT)
  paymentStatus     PaymentStatus?
  approvedAt        DateTime?
  approvedBy        String?
  rejectedReason    String?
  startAt           DateTime?
  expiresAt         DateTime?
  pausedAt          DateTime?
  pausedRemainingMs Int?
  displayOrder      Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  payments Payment[]
  actions  FelicitationAdminAction[]

  @@index([status, startAt, expiresAt])
  @@index([mobile])
  @@index([createdAt])
  @@map("felicitation_entries")
}

model FelicitationAdminAction {
  id          String              @id @default(cuid())
  entryId     String
  entry       FelicitationEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  adminUserId String?
  actor       String
  action      String
  fromStatus  FelicitationStatus?
  toStatus    FelicitationStatus?
  note        String?
  createdAt   DateTime            @default(now())

  @@index([entryId, createdAt])
  @@map("felicitation_admin_actions")
}
