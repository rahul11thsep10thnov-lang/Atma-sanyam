# Copy this file to secrets.properties (which is gitignored) and fill in real values.
# secrets.properties is loaded by app/build.gradle.kts and NEVER committed to source control.

# Google Maps SDK for Android / Places API / Routes API key.
# Create one at https://console.cloud.google.com/google/maps-apis/credentials
# Restrict it to: Maps SDK for Android, Places API, Directions API (or Routes API).
MAPS_API_KEY=YOUR_MAPS_API_KEY_HERE

# Base URL of the backend API (see server/ once implemented in a later phase).
API_BASE_URL=https://api.example.com/
