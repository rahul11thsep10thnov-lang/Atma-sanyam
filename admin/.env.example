# ---------------------------------------------------------------------------
# FOCUS admin console. Copy to .env.local for local development.
# In production set these in your host (e.g. Vercel → Project → Settings →
# Environment Variables). Never commit real values.
# ---------------------------------------------------------------------------

# Base URL of the FOCUS API (no trailing slash). Server-side only: the browser
# never talks to the API directly and never sees the admin token.
API_URL=http://localhost:4000

# Set to "false" ONLY if the console is served over plain http somewhere other
# than localhost (not recommended). Defaults to secure cookies in production.
ADMIN_COOKIE_SECURE=
