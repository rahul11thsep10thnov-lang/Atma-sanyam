// Atma Sanyam — database schema
// See ARCHITECTURE.md §4 for the design rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Reference data
// ---------------------------------------------------------------------------

model Language {
  code        String   @id // ISO 639-1 style code: hi, en, bn, mr, gu, ta, te, kn, ml, pa, or, as
  englishName String
  nativeName  String
  isEnabled   Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  storyTranslations StoryTranslation[]
  storyScripts      StoryScript[]
  audioAssets       AudioAsset[]
  subtitleAssets    SubtitleAsset[]
  videoAssets       VideoAsset[]
  users             User[]
}

enum SourceType {
  NEWS_API
  RSS
  LICENSED_FEED
  MANUAL
}

model NewsSource {
  id               String     @id @default(cuid())
  name             String
  homepageUrl      String
  sourceType       SourceType
  providerKey      String     @unique // matches the NewsSourceProvider registry key
  reliabilityScore Int        @default(60) // 0-100, used by QualityScorer
  isBlacklisted    Boolean    @default(false)
  licenseNotes     String? // terms-of-use / licensing notes for legal review
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  rawArticles  RawArticle[]
  storySources StorySource[]
}

enum PrimaryCategory {
  FAMILY_DISPUTE
  HUSBAND_WIFE
  IN_LAWS
  SIBLING_DISPUTE
  PARENT_CHILD
  PROPERTY_INHERITANCE
  DOMESTIC_CONFLICT
  FAMILY_CRIME
  FAMILY_MURDER
  FAMILY_MISSING_PERSON
  FAMILY_KIDNAPPING
  FAMILY_FRAUD
  NEIGHBOUR_DISPUTE
  OTHER_HUMAN_INTEREST
  NOT_RELEVANT
}

model Location {
  id            String        @id @default(cuid())
  state         String
  district      String?
  city          String?
  masterStories MasterStory[]

  @@unique([state, district, city])
}

// ---------------------------------------------------------------------------
// Ingestion
// ---------------------------------------------------------------------------

enum DedupStatus {
  UNPROCESSED
  NEW_MASTER_STORY
  MERGED_INTO_EXISTING
  DISCARDED_NOT_RELEVANT
  DISCARDED_INSUFFICIENT_INFO
  DISCARDED_DUPLICATE_LOW_VALUE
}

model RawArticle {
  id          String      @id @default(cuid())
  sourceId    String
  externalId  String? // provider's own article id, if available
  url         String
  headline    String
  publishedAt DateTime
  fetchedAt   DateTime    @default(now())
  rawSummary  String // short factual extract only — never the full copyrighted body
  language    String      @default("en")
  dedupStatus DedupStatus @default(UNPROCESSED)

  familyRelevanceScore Int? // 0-100, set by classification stage
  primaryCategory      PrimaryCategory?
  suitabilityScore     Int? // STORY_VIDEO_SUITABILITY_SCORE, 0-100
  rejectionReason      String?

  source       NewsSource    @relation(fields: [sourceId], references: [id])
  storySources StorySource[]

  @@unique([sourceId, externalId])
  @@index([dedupStatus])
  @@index([publishedAt])
}

// ---------------------------------------------------------------------------
// Canonical story
// ---------------------------------------------------------------------------

enum PipelineStatus {
  COLLECTED
  AI_CLASSIFIED
  DUPLICATE_CHECKED
  QUALITY_CHECKED
  SCRIPT_GENERATED
  SAFETY_CHECKED
  PENDING_REVIEW
  APPROVED
  VIDEO_GENERATED
  PUBLISHED
  REJECTED
  FAILED
}

model MasterStory {
  id              String          @id @default(cuid())
  masterStoryHash String          @unique // near-duplicate lookup key (headline+location+date signature)
  title           String
  eventType       PrimaryCategory
  eventDate       DateTime?
  locationId      String?
  peopleInvolved  Json // [{ name, role, ageRange? }]
  relationships   Json // [{ personA, personB, relationship }]
  whatHappened    String
  background      String?
  policeAction    String?
  legalStatus     String? // e.g. "under investigation", "chargesheet filed", "acquitted"
  currentStatus   String?

  familyRelevanceScore Int            @default(0)
  suitabilityScore     Int            @default(0)
  qualityScore         Int            @default(0)
  pipelineStatus       PipelineStatus @default(COLLECTED)
  rejectionReason      String?
  autoPublishEligible  Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  location      Location?          @relation(fields: [locationId], references: [id])
  storySources  StorySource[]
  scripts       StoryScript[]
  translations  StoryTranslation[]
  videoAssets   VideoAsset[]
  adminReviews  AdminReview[]
  studioStories StudioStory[]

  @@index([pipelineStatus])
  @@index([eventType])
  @@index([familyRelevanceScore])
}

// Many-to-many: a MasterStory can be corroborated by multiple RawArticles/sources
model StorySource {
  id            String   @id @default(cuid())
  masterStoryId String
  rawArticleId  String
  sourceId      String
  sourceUrl     String
  publishedAt   DateTime
  createdAt     DateTime @default(now())

  masterStory MasterStory @relation(fields: [masterStoryId], references: [id], onDelete: Cascade)
  rawArticle  RawArticle  @relation(fields: [rawArticleId], references: [id])
  source      NewsSource  @relation(fields: [sourceId], references: [id])

  @@unique([masterStoryId, rawArticleId])
}

// ---------------------------------------------------------------------------
// Script / translation / audio / subtitles / video
// ---------------------------------------------------------------------------

enum ScriptStatus {
  DRAFT
  SAFETY_CHECKED
  APPROVED
  REJECTED
}

model StoryScript {
  id                       String       @id @default(cuid())
  masterStoryId            String
  languageCode             String
  introduction             String
  location                 String
  people                   String
  background               String
  sequence                 String
  authorities              String
  currentStatus            String
  context                  String
  sourceAttribution        String
  wordCount                Int
  estimatedDurationSeconds Int
  status                   ScriptStatus @default(DRAFT)
  safetyFlags              Json? // [{ rule, severity, excerpt, resolved }]
  version                  Int          @default(1)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  masterStory    MasterStory        @relation(fields: [masterStoryId], references: [id], onDelete: Cascade)
  language       Language           @relation(fields: [languageCode], references: [code])
  translations   StoryTranslation[]
  audioAssets    AudioAsset[]
  subtitleAssets SubtitleAsset[]

  @@unique([masterStoryId, languageCode, version])
}

model StoryTranslation {
  id               String   @id @default(cuid())
  masterStoryId    String
  languageCode     String
  localizedTitle   String
  localizedSummary String
  storyScriptId    String
  createdAt        DateTime @default(now())

  masterStory MasterStory @relation(fields: [masterStoryId], references: [id], onDelete: Cascade)
  language    Language    @relation(fields: [languageCode], references: [code])
  storyScript StoryScript @relation(fields: [storyScriptId], references: [id])

  @@unique([masterStoryId, languageCode])
}

model AudioAsset {
  id              String   @id @default(cuid())
  storyScriptId   String
  languageCode    String
  provider        String // e.g. "google-tts", "mock"
  voiceId         String
  storageUrl      String
  durationSeconds Int
  createdAt       DateTime @default(now())

  storyScript StoryScript @relation(fields: [storyScriptId], references: [id], onDelete: Cascade)
  language    Language    @relation(fields: [languageCode], references: [code])

  @@unique([storyScriptId, languageCode])
}

enum SubtitleFormat {
  SRT
  VTT
}

model SubtitleAsset {
  id            String         @id @default(cuid())
  storyScriptId String
  languageCode  String
  format        SubtitleFormat @default(VTT)
  storageUrl    String
  createdAt     DateTime       @default(now())

  storyScript StoryScript @relation(fields: [storyScriptId], references: [id], onDelete: Cascade)
  language    Language    @relation(fields: [languageCode], references: [code])

  @@unique([storyScriptId, languageCode, format])
}

enum RenderStatus {
  PENDING
  RENDERING
  READY
  FAILED
}

model VideoAsset {
  id              String       @id @default(cuid())
  masterStoryId   String
  languageCode    String
  storageUrl      String?
  thumbnailUrl    String?
  durationSeconds Int?
  resolution      String       @default("1080x1920")
  templateVersion String       @default("v1")
  renderStatus    RenderStatus @default(PENDING)
  failureReason   String?
  publishedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  masterStory MasterStory @relation(fields: [masterStoryId], references: [id], onDelete: Cascade)
  language    Language    @relation(fields: [languageCode], references: [code])

  views   View[]
  likes   Like[]
  shares  Share[]
  saves   Save[]
  reports Report[]

  @@unique([masterStoryId, languageCode])
  @@index([renderStatus])
  @@index([publishedAt])
}

// ---------------------------------------------------------------------------
// Users, preferences, engagement
// ---------------------------------------------------------------------------

model User {
  id                    String   @id @default(cuid())
  deviceId              String   @unique
  email                 String?  @unique
  preferredLanguageCode String   @default("en")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  preferredLanguage Language        @relation(fields: [preferredLanguageCode], references: [code])
  preference        UserPreference?
  views             View[]
  likes             Like[]
  shares            Share[]
  saves             Save[]
  reports           Report[]
  devices           DeviceToken[]
}

model UserPreference {
  id                   String            @id @default(cuid())
  userId               String            @unique
  categories           PrimaryCategory[]
  states               String[]
  notificationsEnabled Boolean           @default(true)
  updatedAt            DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  fcmToken  String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model View {
  id           String   @id @default(cuid())
  userId       String?
  videoAssetId String
  watchSeconds Int      @default(0)
  createdAt    DateTime @default(now())

  user       User?      @relation(fields: [userId], references: [id])
  videoAsset VideoAsset @relation(fields: [videoAssetId], references: [id])

  @@index([videoAssetId])
}

model Like {
  id           String   @id @default(cuid())
  userId       String
  videoAssetId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  videoAsset VideoAsset @relation(fields: [videoAssetId], references: [id])

  @@unique([userId, videoAssetId])
}

model Share {
  id           String   @id @default(cuid())
  userId       String?
  videoAssetId String
  channel      String? // whatsapp, sms, other
  createdAt    DateTime @default(now())

  user       User?      @relation(fields: [userId], references: [id])
  videoAsset VideoAsset @relation(fields: [videoAssetId], references: [id])
}

model Save {
  id           String   @id @default(cuid())
  userId       String
  videoAssetId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  videoAsset VideoAsset @relation(fields: [videoAssetId], references: [id])

  @@unique([userId, videoAssetId])
}

enum ReportReason {
  FACTUALLY_INCORRECT
  OFFENSIVE
  PRIVACY_CONCERN
  DUPLICATE
  OTHER
}

model Report {
  id           String       @id @default(cuid())
  userId       String?
  videoAssetId String
  reason       ReportReason
  notes        String?
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?

  user       User?      @relation(fields: [userId], references: [id])
  videoAsset VideoAsset @relation(fields: [videoAssetId], references: [id])
}

// ---------------------------------------------------------------------------
// Admin
// ---------------------------------------------------------------------------

enum AdminRole {
  EDITOR
  SUPER_ADMIN
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(EDITOR)
  createdAt    DateTime  @default(now())

  reviews   AdminReview[]
  auditLogs AdminAuditLog[]
}

enum AdminAction {
  APPROVE
  REJECT
  EDIT
  REGENERATE_SCRIPT
  REGENERATE_AUDIO
  REGENERATE_VIDEO
  REMOVE_VIDEO
  CHANGE_CATEGORY
  CORRECT_METADATA
}

model AdminReview {
  id            String      @id @default(cuid())
  masterStoryId String
  adminUserId   String
  action        AdminAction
  notes         String?
  createdAt     DateTime    @default(now())

  masterStory MasterStory @relation(fields: [masterStoryId], references: [id], onDelete: Cascade)
  adminUser   AdminUser   @relation(fields: [adminUserId], references: [id])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  entity      String
  entityId    String
  diff        Json?
  createdAt   DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([entity, entityId])
}

// Configurable pipeline thresholds (§13, §24, §29)
model PipelineConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ===========================================================================
// VIDEO STUDIO — multilingual animated story video generation
// See docs/VIDEO_STUDIO.md. Table names follow the brief (@@map).
// Language codes are stored as plain strings (validated in code against
// src/studio/language/languageProfiles.ts) so a new language needs no
// migration.
// ===========================================================================

enum StudioStoryStatus {
  DRAFT
  AI_REVIEW
  ADMIN_REVIEW
  APPROVED
  RENDERED
  PUBLISHED
  REJECTED
}

enum StudioFormat {
  SHORT // 1-3 minutes
  LONG // 3-5 minutes
}

enum QcStatus {
  NOT_RUN
  PASSED
  NEEDS_REVIEW
}

model StudioStory {
  id                            String            @id @default(cuid())
  title                         String
  status                        StudioStoryStatus @default(DRAFT)
  format                        StudioFormat      @default(SHORT)
  targetDurationSeconds         Int               @default(150)
  animationStyle                String            @default("flat-2d-editorial")
  languages                     String[] // e.g. ["hi","en"]
  masterLanguage                String            @default("en")
  narratorVoiceCode             String            @default("VOICE_08")
  sourceName                    String?
  sourceUrl                     String?
  locationText                  String?
  state                         String?
  district                      String?
  contentWarnings               String[]
  allowDramatizedReconstruction Boolean           @default(false)
  isSensitive                   Boolean           @default(false)
  sensitiveTopics               String[]
  styleBible                    Json? // consistent visual style: palette, character sheets, location sheets
  timeline                      Json? // factual timeline [{ order, when, event, factIds }]
  analysisSummary               Json? // cleaning stats, provider used, warnings
  qcStatus                      QcStatus          @default(NOT_RUN)
  qcReport                      Json?
  currentMasterScriptId         String?
  masterStoryId                 String? // optional link to an automated-pipeline MasterStory
  createdByAdminId              String?
  approvedByAdminId             String?
  approvedAt                    DateTime?
  publishedAt                   DateTime?
  rejectionReason               String?
  createdAt                     DateTime          @default(now())
  updatedAt                     DateTime          @updatedAt

  masterStory      MasterStory?          @relation(fields: [masterStoryId], references: [id], onDelete: SetNull)
  articles         StudioArticle[]
  facts            StudioFact[]
  characters       StudioCharacter[]
  voiceAssignments VoiceAssignment[]
  scripts          StudioScript[]
  scenes           StudioScene[]
  audioFiles       AudioFile[]
  audioSegments    AudioSegment[]
  subtitles        StudioSubtitle[]
  project          VideoProject?
  renders          VideoRender[]
  safetyReviews    ContentSafetyReview[]
  versions         ContentVersion[]
  jobs             GenerationJob[]

  @@index([status])
  @@map("stories")
}

model StudioArticle {
  id                 String   @id @default(cuid())
  storyId            String
  version            Int      @default(1)
  title              String
  rawText            String
  cleanedText        String?
  sourceName         String?
  sourceUrl          String?
  images             Json? // [{ storageKey, url, caption }]
  characterNotes     String?
  sceneNotes         String?
  pronunciationGuide Json? // [{ term, pronunciation, languageCode? }]
  contentHash        String
  createdByAdminId   String?
  createdAt          DateTime @default(now())

  story StudioStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, version])
  @@map("articles")
}

enum FactType {
  PERSON_NAME
  DATE
  TIME
  LOCATION
  NUMBER
  AGE
  MONEY
  ORGANIZATION
  QUOTE
  CLAIM
  ALLEGATION
  OFFICIAL_STATEMENT
  EVENT
}

enum VerificationStatus {
  VERIFIED
  UNVERIFIED
  REPORTED
  ALLEGED
  UNKNOWN
}

enum StatementType {
  DIRECT_QUOTE
  REPORTED_STATEMENT
  AI_NARRATION
  RECONSTRUCTED_DIALOGUE
}

model StudioFact {
  id                 String             @id @default(cuid())
  storyId            String
  articleVersion     Int
  type               FactType
  value              String
  normalizedValue    String?
  sourceSentence     String?
  attributedTo       String? // who said/claimed it
  statementType      StatementType?
  verificationStatus VerificationStatus @default(REPORTED)
  isKeyFact          Boolean            @default(false)
  timelineOrder      Int?
  adminEdited        Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  story StudioStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId, type])
  @@map("facts")
}

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}

enum AgeGroup {
  CHILD
  YOUNG
  ADULT
  ELDERLY
  UNKNOWN
}

model StudioCharacter {
  id             String   @id @default(cuid())
  storyId        String
  key            String // CHAR_01, CHAR_02 … stable within a story
  displayName    String // as used in narration ("the woman's husband" for anonymised people)
  realName       String? // only when publicly named in the source and not protected
  role           String // "wife", "police officer", "neighbour"…
  gender         Gender   @default(UNKNOWN)
  ageGroup       AgeGroup @default(UNKNOWN)
  isMinor        Boolean  @default(false)
  isOfficial     Boolean  @default(false)
  isRealPerson   Boolean  @default(true)
  anonymized     Boolean  @default(false)
  speaks         Boolean  @default(false)
  appearance     Json? // fixed per story: { clothing, build, hair, accessories, palette }
  pronunciations Json? // { "hi": "…", "en": "…" }
  adminEdited    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  story       StudioStory       @relation(fields: [storyId], references: [id], onDelete: Cascade)
  assignments VoiceAssignment[]

  @@unique([storyId, key])
  @@map("characters")
}

enum VoiceTone {
  NEUTRAL
  WARM
  AUTHORITATIVE
}

model Voice {
  id                 String    @id @default(cuid())
  code               String    @unique // VOICE_01 … VOICE_08
  label              String
  gender             Gender
  ageGroup           AgeGroup
  tone               VoiceTone @default(NEUTRAL)
  description        String?
  providerVoiceIds   Json // { elevenlabs: "id", chatterbox: "name", google: { hi: "hi-IN-…" } }
  settings           Json? // { stability, similarity, style, speakingRate }
  isNarratorEligible Boolean   @default(false)
  isActive           Boolean   @default(true)
  sampleUrl          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assignments VoiceAssignment[]

  @@map("voices")
}

model VoiceAssignment {
  id            String   @id @default(cuid())
  storyId       String
  speakerKey    String // "NARRATOR" or a character key
  characterId   String?
  voiceId       String
  lockedByAdmin Boolean  @default(false)
  reason        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  story     StudioStory      @relation(fields: [storyId], references: [id], onDelete: Cascade)
  character StudioCharacter? @relation(fields: [characterId], references: [id], onDelete: Cascade)
  voice     Voice            @relation(fields: [voiceId], references: [id])

  @@unique([storyId, speakerKey])
  @@map("voice_assignments")
}

enum ScriptKind {
  MASTER
  LANGUAGE
}

enum StudioScriptStatus {
  DRAFT
  AI_REVIEWED
  APPROVED
  SUPERSEDED
}

model StudioScript {
  id                       String             @id @default(cuid())
  storyId                  String
  kind                     ScriptKind
  languageCode             String
  version                  Int
  parentScriptId           String? // LANGUAGE scripts point at the MASTER version they localise
  status                   StudioScriptStatus @default(DRAFT)
  provider                 String // which LLM/translation provider produced it
  content                  Json // LANGUAGE: { title, scenes: [{ sceneNumber, narratorText, dialogue[], onScreenText }] }
  estimatedDurationSeconds Int
  lintFlags                Json?
  contentHash              String
  createdByAdminId         String?
  createdAt                DateTime           @default(now())

  story  StudioStory   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  scenes StudioScene[]

  @@unique([storyId, kind, languageCode, version])
  @@index([storyId, kind, languageCode])
  @@map("scripts")
}

enum SafetyLevel {
  SAFE
  SENSITIVE
  RESTRICTED
}

model StudioScene {
  id                    String      @id @default(cuid())
  storyId               String
  scriptId              String // MASTER script version this scene belongs to
  sceneNumber           Int
  durationSeconds       Float
  location              String
  timeOfDay             String
  characters            String[] // character keys
  narratorText          String
  dialogue              Json // [{ speakerKey, text, statementType, factId? }]
  emotionalTone         String
  cameraDirection       String
  background            String
  props                 String[]
  animationRequirements String
  audioRequirements     Json // { ambient: "room-tone", sfx: ["door-close"] }
  contentRestrictions   String[]
  transition            String
  onScreenText          String?
  safetyLevel           SafetyLevel @default(SAFE)
  safetyReasons         String[]
  visualHash            String // hash of everything that affects the visual
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  story         StudioStory    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  script        StudioScript   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  visualPrompts VisualPrompt[]
  assets        SceneAsset[]

  @@unique([scriptId, sceneNumber])
  @@map("scenes")
}

model VisualPrompt {
  id               String   @id @default(cuid())
  sceneId          String
  prompt           String
  negativePrompt   String
  isSubstitute     Boolean  @default(false)
  substituteReason String?
  promptHash       String
  createdAt        DateTime @default(now())

  scene  StudioScene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  assets SceneAsset[]

  @@index([promptHash])
  @@map("visual_prompts")
}

enum AssetKind {
  IMAGE
  ANIMATION
}

enum AssetStatus {
  PENDING
  READY
  FAILED
}

model SceneAsset {
  id              String      @id @default(cuid())
  sceneId         String
  visualPromptId  String?
  kind            AssetKind
  provider        String
  storageKey      String?
  url             String?
  width           Int?
  height          Int?
  durationSeconds Float?
  promptHash      String
  status          AssetStatus @default(PENDING)
  isPlaceholder   Boolean     @default(false)
  failureReason   String?
  createdAt       DateTime    @default(now())

  scene        StudioScene   @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  visualPrompt VisualPrompt? @relation(fields: [visualPromptId], references: [id], onDelete: SetNull)

  @@index([promptHash, kind])
  @@map("scene_assets")
}

enum TrackType {
  NARRATION
  DIALOGUE
  AMBIENT
  MUSIC
  SFX
  MIX
}

model AudioFile {
  id              String    @id @default(cuid())
  storyId         String
  languageCode    String
  scriptId        String? // LANGUAGE script version this track was built from
  trackType       TrackType
  provider        String
  storageKey      String
  url             String
  durationSeconds Float
  inputsHash      String
  createdAt       DateTime  @default(now())

  story StudioStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId, languageCode, trackType])
  @@map("audio_files")
}

model AudioSegment {
  id              String   @id @default(cuid())
  storyId         String
  languageCode    String
  scriptId        String
  sceneNumber     Int
  lineIndex       Int // 0 = narration, 1.. = dialogue lines in order
  speakerKey      String
  voiceCode       String
  provider        String
  providerVoiceId String?
  text            String
  storageKey      String
  url             String
  durationSeconds Float
  startSeconds    Float? // position in the language timeline, set by the audio timeline stage
  isPlaceholder   Boolean  @default(false)
  cacheHash       String // provider+voice+language+text+settings
  createdAt       DateTime @default(now())

  story StudioStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([scriptId, sceneNumber, lineIndex])
  @@index([cacheHash])
  @@map("audio_segments")
}

model StudioSubtitle {
  id           String         @id @default(cuid())
  storyId      String
  languageCode String
  renderId     String?
  format       SubtitleFormat
  storageKey   String
  url          String
  cues         Json
  createdAt    DateTime       @default(now())

  story StudioStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId, languageCode])
  @@map("subtitles")
}

model VideoProject {
  id                String   @id @default(cuid())
  storyId           String   @unique
  masterScriptId    String
  timeline          Json // master visual timeline: [{ sceneNumber, sceneId, assetId, baseDurationSeconds, transition }]
  width             Int      @default(1920)
  height            Int      @default(1080)
  fps               Int      @default(25)
  burnSubtitles     Boolean  @default(false)
  multiAudioPackage Boolean  @default(false)
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  story   StudioStory   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  renders VideoRender[]

  @@map("video_projects")
}

enum StudioRenderKind {
  SINGLE_LANGUAGE
  MULTI_AUDIO
}

model VideoRender {
  id              String           @id @default(cuid())
  projectId       String
  storyId         String
  languageCode    String? // null for the multi-audio package
  kind            StudioRenderKind
  version         Int
  status          RenderStatus     @default(PENDING)
  storageKey      String?
  url             String?
  thumbnailUrl    String?
  durationSeconds Float?
  width           Int
  height          Int
  fps             Int
  inputsHash      String
  renderer        String?
  failureReason   String?
  isCurrent       Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  project VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  story   StudioStory  @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId, languageCode, isCurrent])
  @@index([inputsHash])
  @@map("video_renders")
}

model ContentSafetyReview {
  id           String      @id @default(cuid())
  storyId      String
  sceneId      String? // null = story-level
  level        SafetyLevel
  reasons      String[]
  substitution String?
  source       String // "auto" or "admin"
  adminUserId  String?
  notes        String?
  createdAt    DateTime    @default(now())

  story StudioStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId])
  @@map("content_safety")
}

model MusicTrack {
  id              String   @id @default(cuid())
  title           String
  mood            String // "somber", "neutral", "hopeful", "tense-subtle"
  storageKey      String
  url             String
  durationSeconds Float
  license         String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@map("music")
}

model SoundEffect {
  id              String   @id @default(cuid())
  tag             String // "rain", "traffic-distant", "door-close", "footsteps", "siren-distant"
  title           String
  storageKey      String
  url             String
  durationSeconds Float
  license         String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([tag])
  @@map("sound_effects")
}

model ContentVersion {
  id               String   @id @default(cuid())
  storyId          String
  entityType       String // "ARTICLE" | "MASTER_SCRIPT" | "LANGUAGE_SCRIPT" | "SCENE" | "RENDER"
  entityId         String
  languageCode     String?
  version          Int
  snapshot         Json
  reason           String?
  createdByAdminId String?
  createdAt        DateTime @default(now())

  story StudioStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId, entityType])
  @@map("versions")
}

enum GenerationJobType {
  ANALYZE_ARTICLE
  GENERATE_MASTER_SCRIPT
  GENERATE_LANGUAGE_SCRIPT
  AI_REVIEW
  GENERATE_SCENE_VISUAL
  GENERATE_VOICE
  RENDER_LANGUAGE
  RENDER_PACKAGE
  FINAL_QC
  PUBLISH
}

enum GenerationJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  RETRYING
}

model GenerationJob {
  id           String              @id @default(cuid())
  storyId      String
  type         GenerationJobType
  status       GenerationJobStatus @default(PENDING)
  languageCode String?
  sceneId      String?
  payload      Json?
  result       Json?
  error        String?
  attempts     Int                 @default(0)
  maxAttempts  Int                 @default(3)
  dedupeKey    String?             @unique
  requestedBy  String? // admin user id, or "pipeline"
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  story StudioStory     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  logs  GenerationLog[]

  @@index([storyId, createdAt])
  @@index([status])
  @@map("generation_jobs")
}

model GenerationLog {
  id        String   @id @default(cuid())
  jobId     String
  level     String // info | warn | error
  message   String
  data      Json?
  createdAt DateTime @default(now())

  job GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@map("generation_logs")
}

enum ProviderKind {
  LLM
  TRANSLATION
  VOICE
  IMAGE
  VIDEO
  MUSIC
  STORAGE
}

// Non-secret provider settings. API keys stay in environment variables.
model ProviderConfig {
  id        String       @id @default(cuid())
  kind      ProviderKind
  key       String
  isEnabled Boolean      @default(true)
  priority  Int          @default(100)
  settings  Json? // { model, baseUrl, languages: [...] } — never secrets
  updatedAt DateTime     @updatedAt

  @@unique([kind, key])
  @@map("provider_configs")
}

// Cache for LLM analysis and translations (cost control).
model AiCache {
  key       String   @id // sha256 of provider+model+prompt
  value     Json
  hits      Int      @default(0)
  createdAt DateTime @default(now())

  @@map("ai_cache")
}
