{
  "_meta_template": {
    "description": "FLUX.1 [schnell] text-to-image (ComfyUI API format). Placeholders are filled by ComfyImageProvider.",
    "requires": ["checkpoint flux1-schnell-fp8.safetensors in models/checkpoints (all-in-one fp8 checkpoint with CLIP + VAE)"],
    "custom_nodes": [],
    "notes": "FLUX schnell uses cfg 1.0, so the negative prompt has no effect; an empty negative conditioning is still required by KSampler."
  },
  "1": { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "{{checkpoint}}" } },
  "2": { "class_type": "CLIPTextEncode", "inputs": { "text": "{{prompt}}", "clip": ["1", 1] } },
  "3": { "class_type": "CLIPTextEncode", "inputs": { "text": "", "clip": ["1", 1] } },
  "4": { "class_type": "EmptySD3LatentImage", "inputs": { "width": "{{width}}", "height": "{{height}}", "batch_size": 1 } },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["4", 0],
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "sampler_name": "{{sampler}}",
      "scheduler": "{{scheduler}}",
      "denoise": 1
    }
  },
  "6": { "class_type": "VAEDecode", "inputs": { "samples": ["5", 0], "vae": ["1", 2] } },
  "7": { "class_type": "SaveImage", "inputs": { "images": ["6", 0], "filename_prefix": "{{filename_prefix}}" } }
}
