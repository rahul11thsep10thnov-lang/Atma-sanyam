# Copy to .env and fill in real values. Never commit .env.
# Every provider below has a mock/no-op implementation so the app runs
# end-to-end without any of these keys during development and tests.

NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://atma:atma@localhost:5432/atma_sanyam
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-dev-only
ADMIN_JWT_SECRET=change-me-admin-dev-only

# --- News ingestion ---
NEWS_API_ORG_KEY=
NEWS_API_ORG_BASE_URL=https://newsapi.org/v2
RSS_FEED_URLS=

# --- AI (Anthropic Claude) ---
ANTHROPIC_API_KEY=
CLASSIFICATION_MODEL=claude-haiku-4-5-20251001
SCRIPT_GENERATION_MODEL=claude-sonnet-5

# --- Text to speech ---
TTS_PROVIDER=mock
GOOGLE_TTS_API_KEY=

# --- Object storage (S3-compatible, e.g. Cloudflare R2) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=atma-sanyam-media
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/media

# --- Firebase Cloud Messaging ---
FCM_SERVER_KEY=

# --- Pipeline thresholds (overridable at runtime via admin API/PipelineConfig table) ---
MIN_FAMILY_RELEVANCE_SCORE=60
MIN_VIDEO_SUITABILITY_SCORE=70
MIN_QUALITY_SCORE=70
AUTO_PUBLISH_ENABLED=false
