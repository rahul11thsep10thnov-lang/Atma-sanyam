# ---------------------------------------------------------------------------
# LoJi API — copy to .env for local development. NEVER commit a real .env.
# In production set these in your host's dashboard (Render/Railway/Fly...).
# ---------------------------------------------------------------------------

# development | production | test
NODE_ENV=development
PORT=4000

# PostgreSQL connection string. Local example below; for Neon/Supabase/Render
# paste the URL they give you (it should include ?sslmode=require).
DATABASE_URL=postgres://focus:focus-local-dev@localhost:5432/focus_dev
DATABASE_POOL_MAX=10

# Reverse-proxy hops in front of the API (1 on Render/Railway/Fly; 0 locally
# if you hit the API directly). Needed for correct rate limiting by IP.
TRUST_PROXY=1

# Browser origins allowed to call the API directly (comma-separated). The LoJi
# website (Expo web) needs its origin here; native apps and the admin console
# (server-side proxy) do not. http://localhost:8081 is `expo start --web`.
CORS_ORIGINS=http://localhost:8081

ADMIN_SESSION_TTL_HOURS=12
GUARDIAN_SESSION_TTL_DAYS=30
PLAYER_SESSION_TTL_DAYS=14
# Days between a deletion request and the data actually being removed.
DELETION_COOLING_OFF_DAYS=7

# Optional but recommended once push is live: create at
# https://expo.dev/accounts/<you>/settings/access-tokens and enable
# "Enhanced security for push notifications" in your Expo project.
EXPO_ACCESS_TOKEN=

# Only used by `npm run seed:admin` to create the first Super Admin.
# Remove from the environment after the first run.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=

# Transactional email (receipts, support) via Resend. Optional.
RESEND_API_KEY=
EMAIL_FROM=LoJi <no-reply@your-domain.com>

# One-time codes by SMS (guardian sign-in, step-up, player approval).
# SMS_PROVIDER is msg91 (India; needs a DLT-approved OTP template), twilio,
# or console (development only: codes are printed to the API log).
# Without a provider only OTP_TEST_NUMBERS can sign in. See docs/OTP_PROVIDERS.md.
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Country code assumed when a number is typed without one.
DEFAULT_COUNTRY_CODE=91
# Seconds between two codes to the same number.
OTP_RESEND_COOLDOWN_S=45
# Numbers with a fixed verification code (no SMS is sent), for app-store
# review and automated tests: "+919999900001:123456,+919999900002:654321".
# Ignored in production unless OTP_TEST_NUMBERS_ALLOW_PRODUCTION=true.
OTP_TEST_NUMBERS=
OTP_TEST_NUMBERS_ALLOW_PRODUCTION=false

# ---- Subscriptions (docs/SUBSCRIPTIONS.md) ---------------------------------
# The monthly product id (Google Play subscription product id) and the price
# shown on the website/receipts (the store shows its own localised price).
SUBSCRIPTION_PRODUCT_ID=loji_monthly
SUBSCRIPTION_PRICE_INR=199
# Google Play Developer API: the app's package name and a service-account
# JSON key (raw JSON or base64) with "View financial data" and "Manage orders
# and subscriptions" on the app in Play Console.
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Real-time developer notifications: a random secret that is part of the
# Pub/Sub push endpoint URL (…/v1/webhooks/google-play?token=<this>).
GOOGLE_PLAY_RTDN_TOKEN=
# Razorpay Subscriptions for the website.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
# Development/tests only: activate subscriptions with no payment. Ignored in production.
BILLING_SANDBOX=true

# Retention for `npm run cleanup`.
EVENTS_RETENTION_DAYS=395
SCREEN_TIME_RETENTION_DAYS=120

# Development only (ignored when NODE_ENV=production): print emails to the API log.
MAIL_DEV_LOG=false

# ---- Source registry & fact ingestion (docs/SOURCE_REGISTRY.md) -------------
# Registered sources are licence-checked automatically; facts are ingested only
# from approved sources. No third-party API key is required for the built-in
# connector (Wikipedia). Wikimedia and others ask that the bot identify you:
SOURCE_BOT_CONTACT=ops@your-domain.com
SOURCE_MAINTENANCE_ENABLED=true
SOURCE_CHECK_INTERVAL_HOURS=24
SOURCE_FETCH_TIMEOUT_MS=10000
SOURCE_FETCH_RETRIES=2
SOURCE_MIN_REQUEST_INTERVAL_MS=1500
SOURCE_MAX_CHECKS_PER_RUN=40
# Optional discovery: JSON feeds of candidate sources (an array of
# {"publisher","title","url","notes"}), accepted only for hosts under the
# allowed domains. Candidates are registered as pending_review, never approved.
SOURCE_DISCOVERY_FEEDS=
SOURCE_DISCOVERY_ALLOWED_DOMAINS=
SOURCE_DISCOVERY_MAX_PER_RUN=10
FACT_INGEST_ENABLED=true
# false: ingested facts wait as "verified" for an editor to publish.
FACT_INGEST_AUTO_PUBLISH=false
FACT_INGEST_MAX_PER_RUN=10
