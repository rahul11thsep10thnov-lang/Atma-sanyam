# PoliceExams API — copy to .env and fill in. Never commit .env.

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string (Supabase: Project Settings → Database →
# Connection string, "Session pooler" URI). Leave EMPTY for local development:
# an embedded database is created in ./.data automatically.
DATABASE_URL=

PORT=4000
# The website's origin(s), comma-separated, so browsers may call the API.
CORS_ORIGINS=http://localhost:3000

# --- Website login (optional) -----------------------------------------------
# Same Supabase project the website uses for Google / mobile OTP login.
# The anon key is public by design; the service-role key is NOT needed here.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- AI ---------------------------------------------------------------------
# MOCK_AI=true generates realistic questions locally: no key, no cost.
# Set MOCK_AI=false and AI_API_KEY to use the real AI provider.
MOCK_AI=true
AI_PROVIDER=anthropic
# Server-side only. Never put this in the website or any client code.
AI_API_KEY=
AI_GENERATION_MODEL=claude-opus-5
AI_REVIEW_MODEL=claude-opus-5
# low | medium | high | xhigh | max (higher = more careful, more tokens)
AI_EFFORT=high

# Defaults for Settings in the admin console (editable there later).
AI_BATCH_SIZE=20
AI_MAX_RETRIES=2
AI_GENERATION_TIMEOUT_MS=600000
AI_REVIEW_TIMEOUT_MS=300000
AI_MAX_QUESTIONS_PER_JOB=2000
# Hard monthly cap on AI spend in USD (empty = no cap).
AI_MONTHLY_BUDGET_USD=

# --- Enrolment / payments ---------------------------------------------------
# Razorpay keys for the yearly Mock Test Pass (Dashboard → Settings → API Keys).
# Server-side only. The website receives just the public key id in an order.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Settings → Webhooks: URL https://<api>/api/enroll/razorpay/webhook,
# events order.paid + payment.captured. Activates plans whose buyer closed the
# browser before confirming. Same secret here.
RAZORPAY_WEBHOOK_SECRET=
# Without Razorpay keys, lets a user "enrol" with a dev order (no money moves)
# so the flow can be tested. Keep false in production.
ENROLL_DEV_ACTIVATE=false

# --- Alerts (docs/OPERATIONS.md) -------------------------------------------------
# Errors, crashes, DB-down, failed generation jobs and failed payment checks are
# sent here. Slack or Discord incoming-webhook URL, and/or a Telegram bot + chat.
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# At most one message per kind of problem every N seconds (repeats are grouped).
ALERT_MIN_INTERVAL_SECONDS=600

# --- Worker -----------------------------------------------------------------
WORKER_ENABLED=true
WORKER_CONCURRENCY=2

# --- First admin (used by `npm run seed`) -----------------------------------
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
