# ---------------------------------------------------------------------------
# FOCUS API — copy to .env for local development. NEVER commit a real .env.
# In production set these in your host's dashboard (Render/Railway/Fly...).
# ---------------------------------------------------------------------------

# development | production | test
NODE_ENV=development
PORT=4000

# PostgreSQL connection string. Local example below; for Neon/Supabase/Render
# paste the URL they give you (it should include ?sslmode=require).
DATABASE_URL=postgres://focus:focus-local-dev@localhost:5432/focus_dev
DATABASE_POOL_MAX=10

# Reverse-proxy hops in front of the API (1 on Render/Railway/Fly; 0 locally
# if you hit the API directly). Needed for correct rate limiting by IP.
TRUST_PROXY=1

# Browser origins allowed to call the API directly (comma-separated).
# Mobile apps and the admin console (server-side proxy) don't need this.
# Add http://localhost:8081 only if you test the app with `expo start --web`.
CORS_ORIGINS=http://localhost:8081

ADMIN_SESSION_TTL_HOURS=12
USER_SESSION_TTL_DAYS=30

# Optional but recommended once push is live: create at
# https://expo.dev/accounts/<you>/settings/access-tokens and enable
# "Enhanced security for push notifications" in your Expo project.
EXPO_ACCESS_TOKEN=

# Only used by `npm run seed:admin` to create the first Super Admin.
# Remove from the environment after the first run.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=

# Password reset emails ("forgot password" in the app). Create a free key at
# https://resend.com, verify your sending domain, then set both values.
# Leave empty to hide "Forgot password?" in the app.
RESEND_API_KEY=
EMAIL_FROM=FOCUS <no-reply@your-domain.com>

# Analytics events older than this are deleted by `npm run cleanup`.
EVENTS_RETENTION_DAYS=395

# Development only (ignored when NODE_ENV=production): print emails such as
# reset codes to the API log instead of sending them.
MAIL_DEV_LOG=false
