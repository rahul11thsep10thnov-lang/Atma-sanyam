# Copy to .env and fill in real values. Never commit .env.
# Every provider below has a mock/no-op implementation so the app runs
# end-to-end without any of these keys during development and tests.

NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://atma:atma@localhost:5432/atma_sanyam
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-dev-only
ADMIN_JWT_SECRET=change-me-admin-dev-only

# --- News ingestion ---
NEWS_API_ORG_KEY=
NEWS_API_ORG_BASE_URL=https://newsapi.org/v2
RSS_FEED_URLS=

# --- AI (Anthropic Claude) ---
ANTHROPIC_API_KEY=
CLASSIFICATION_MODEL=claude-haiku-4-5-20251001
SCRIPT_GENERATION_MODEL=claude-sonnet-5

# --- Text to speech ---
TTS_PROVIDER=mock
GOOGLE_TTS_API_KEY=

# --- Video Studio (docs/VIDEO_STUDIO.md §11) ---
# Every provider below is optional: without keys the Studio still renders
# real MP4s, but with placeholder art and silent placeholder voices (QC flags them).
STUDIO_LLM_MODEL=claude-sonnet-5
# Voices — set the voice IDs per base voice on the admin "Voices" page.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Only list languages you have verified on your ElevenLabs model/plan.
ELEVENLABS_LANGUAGES=en,hi,ta
CHATTERBOX_BASE_URL=
CHATTERBOX_API_KEY=
CHATTERBOX_LANGUAGES=en,hi
GOOGLE_TTS_LANGUAGES=hi,en,bn,mr,gu,ta,te,kn,ml,pa
VOICE_PROVIDER_PRIORITY=elevenlabs,chatterbox,google,mock
# Translation: llm (uses ANTHROPIC_API_KEY), google, or passthrough
TRANSLATION_PROVIDER=llm
GOOGLE_TRANSLATE_API_KEY=
# Images: placeholder (offline) or openai-compatible
IMAGE_PROVIDER=placeholder
IMAGE_PROVIDER_API_KEY=
IMAGE_PROVIDER_BASE_URL=https://api.openai.com/v1
IMAGE_PROVIDER_MODEL=gpt-image-1
# Animation: kenburns (local FFmpeg, default) or http (generic image-to-video API)
VIDEO_PROVIDER=kenburns
VIDEO_PROVIDER_API_KEY=
VIDEO_PROVIDER_BASE_URL=
MUSIC_PROVIDER=library
# Output
STUDIO_DEFAULT_RESOLUTION=1080p
STUDIO_DEFAULT_FPS=25
STUDIO_ORIENTATION=landscape
# Workers: roles all | studio | render (run render workers on separate hosts to scale)
STUDIO_WORKER_CONCURRENCY=4
STUDIO_RENDER_CONCURRENCY=1
STUDIO_WORKER_ROLES=all
# true = run studio jobs inside the API process (no Redis needed; for local testing)
STUDIO_INLINE_JOBS=false
# Never applies to sensitive stories.
STUDIO_AUTO_PUBLISH_NON_SENSITIVE=false
# Folder with Noto fonts for burned-in Indic subtitles (defaults to system fonts)
STUDIO_FONT_DIR=

# --- Object storage (S3-compatible, e.g. Cloudflare R2) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=atma-sanyam-media
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/media

# --- Firebase Cloud Messaging ---
FCM_SERVER_KEY=

# --- Pipeline thresholds (overridable at runtime via admin API/PipelineConfig table) ---
MIN_FAMILY_RELEVANCE_SCORE=60
MIN_VIDEO_SUITABILITY_SCORE=70
MIN_QUALITY_SCORE=70
AUTO_PUBLISH_ENABLED=false
