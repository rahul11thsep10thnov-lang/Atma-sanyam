# ---------------------------------------------------------------------------
# budgettourism — environment variables
# Copy this file to .env.local (dev) or configure these in your hosting
# provider (production) and fill in real values. Never commit a real .env
# file. Every value below has a safe fallback in code, so the app runs with
# demo data even if you leave most of these unset.
# ---------------------------------------------------------------------------

# Public site URL — used for canonical URLs, sitemap.xml, OpenGraph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (PostgreSQL + Prisma)
# ---------------------------------------------------------------------------
# Without this set, the site runs on the in-memory master database built by
# lib/master/seed, and write endpoints (/api/reviews, /api/trips,
# /api/wishlist, /api/admin/*) validate input but report that nothing was
# persisted. See README -> "Going to production".
DATABASE_URL="postgresql://user:password@localhost:5432/budgettourism"

# ---------------------------------------------------------------------------
# Authentication (NextAuth.js)
# ---------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Google OAuth (optional) — sign-in is hidden until both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------
# Production: only these signed-in emails may open /admin (comma-separated).
ADMIN_EMAILS=
# Production: token for /api/admin/* (sent as the x-admin-token header).
ADMIN_API_TOKEN=

# ---------------------------------------------------------------------------
# AI content (optional — the deterministic template writer is the default)
# ---------------------------------------------------------------------------
# AI_PROVIDER=anthropic uses the LLM writer for page prose. It only ever
# receives structured records and its output goes through the same fact-check.
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL=
# true = serve only editor-approved (PUBLISHED) generated content.
REQUIRE_EDITOR_APPROVAL=false

# ---------------------------------------------------------------------------
# Weather (lib/providers/weather)
# ---------------------------------------------------------------------------
# Without this set, WeatherSection/`/api/weather` fall back to a
# deterministic demo forecast clearly labelled as sample data. Never expose
# this key in client-side code — it is only read on the server.
WEATHER_API_KEY=

# ---------------------------------------------------------------------------
# Maps (lib/providers/maps)
# ---------------------------------------------------------------------------
# "openstreetmap" (default, no key required), "google", or "mappls".
MAP_PROVIDER=openstreetmap
GOOGLE_MAPS_API_KEY=
MAPPLS_API_KEY=

# ---------------------------------------------------------------------------
# Future integrations (adapters already exist under lib/providers/*;
# wiring real credentials here activates them without code changes)
# ---------------------------------------------------------------------------
HOTEL_BOOKING_API_KEY=
FLIGHT_AFFILIATE_API_KEY=
ADVERTISING_PROVIDER=
ADVERTISING_API_KEY=

# ---------------------------------------------------------------------------
# Image storage (S3-compatible; lib/data image system, section 24)
# ---------------------------------------------------------------------------
IMAGE_CDN_BASE_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Content CMS + destination pipeline (optional — everything degrades honestly)
# ---------------------------------------------------------------------------
# Destination records live as JSON documents in data/cms/ (no database server
# needed). Keys below can also be entered in Admin → Content → Settings; an
# environment variable always takes precedence over the stored setting.

# Ratings: only ever read through the official Google Places API. Without a
# key every attraction shows "Rating unavailable" — ratings are never invented.
GOOGLE_PLACES_API_KEY=

# Licensed image sources for attraction photo candidates (Wikimedia Commons
# needs no key and only returns CC/public-domain files).
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
