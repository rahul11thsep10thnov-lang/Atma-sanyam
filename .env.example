# Supabase project settings (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — used by scripts/seed-supabase.ts and admin routes.
# NEVER expose this in client code or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: same value as NEXT_PUBLIC_SUPABASE_URL, used by the seed script
# when running outside of Next.js.
SUPABASE_URL=

# PoliceExams API (the backend/ folder). When set, mock tests published from
# the admin console appear on the website and are scored by the server.
# Leave empty to run the website on its built-in demo tests only.
# Public by design: it is only the address of the API, not a secret.
NEXT_PUBLIC_API_URL=
