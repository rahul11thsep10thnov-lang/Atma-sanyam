# ---------------------------------------------------------------------------
# LoJi app (native + web) — local development settings.
# Copy to `.env` (Expo CLI loads it automatically). EXPO_PUBLIC_* values are
# baked into the app bundle, so NEVER put secrets here — public URLs only.
#
# For EAS builds, set the same variables per environment on expo.dev
# (see docs/DEPLOYMENT.md → "Mobile app environment variables").
# ---------------------------------------------------------------------------

# LoJi API base URL (required: accounts, subscriptions and the catalogue live
# on the server). On a real phone, use your computer's LAN IP, e.g.
# http://192.168.1.20:4000. For the website add its origin to CORS_ORIGINS.
EXPO_PUBLIC_API_URL=

# development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Shown in Settings → About and on the sign-up screen. Required for store review.
# The in-app legal texts (src/legal/documents.ts) are used when these are empty.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
