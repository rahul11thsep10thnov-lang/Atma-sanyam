# ============================================================
# AI WHITEBOARD TEACHER STUDIO - environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit a real .env file to git.
# ============================================================

# ---- Core ----
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-random-secret-in-production
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ---- Mock mode (works with no paid APIs) ----
# When true, AI calls return deterministic sample lesson data.
MOCK_AI=true
# When true, voice generation produces deterministic placeholder audio.
MOCK_VOICE=true

# ---- Database ----
DATABASE_URL=postgresql+psycopg://studio:studio@localhost:5432/whiteboard_studio
# For local sandboxed development without Postgres installed, you may use:
# DATABASE_URL=sqlite:///./storage/dev.db

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- Storage ----
STORAGE_BACKEND=local
# Relative paths are resolved against the current working directory of the
# process that reads this .env file. Prefer an absolute path in production.
# If unset, defaults to <repo_root>/storage regardless of cwd.
STORAGE_PATH=./storage

# ---- LLM provider (server-side only, never exposed to the frontend) ----
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5

# ---- ElevenLabs (server-side only, never exposed to the frontend) ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_STYLE=0.0
ELEVENLABS_SPEED=1.0

# ---- Default retention policy (days; see docs/PRIVACY.md) ----
RETENTION_SOURCE_FILES_DAYS=30
RETENTION_EXTRACTED_TEXT_DAYS=30
RETENTION_LESSON_DATA_DAYS=90
RETENTION_AUDIO_DAYS=30
RETENTION_PREVIEW_VIDEO_DAYS=7
RETENTION_FINAL_VIDEO_DAYS=90
RETENTION_THUMBNAILS_DAYS=90
RETENTION_TEMP_FILES_HOURS=24
RETENTION_JOB_LOGS_DAYS=30
RETENTION_FAILED_JOB_ARTIFACTS_DAYS=7

# ---- Renderer ----
RENDERER_PATH=../renderer
REMOTION_CONCURRENCY=2
DEFAULT_VIDEO_WIDTH=1920
DEFAULT_VIDEO_HEIGHT=1080
DEFAULT_VIDEO_FPS=30
