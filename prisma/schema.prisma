// budgettourism — master India tourism database schema (PostgreSQL).
//
// Architecture: RAW SOURCES → STRUCTURED FACTS → VERIFICATION → MASTER DATABASE →
// DESTINATION GRAPH → AI CONTENT → VALIDATION → WEBPAGE. This file is the master
// database. Run `npm run prisma:migrate` once DATABASE_URL is set, then
// `npm run prisma:seed` to load the seed dataset.
//
// The controlled-vocabulary enums below are generated from lib/master/enums.ts;
// scripts/verify-engine.ts fails if the two drift apart.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

