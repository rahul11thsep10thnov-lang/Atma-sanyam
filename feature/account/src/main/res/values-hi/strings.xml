    <string name="account_safety_title">सुरक्षा</string>
    <string name="account_safety_intro">कुछ आसान आदतें हर डिलीवरी को सुरक्षित रखती हैं।</string>
    <string name="account_safety_tip_pack">ड्राइवर के आने से पहले सामान मज़बूती से पैक करें और नाज़ुक चीज़ों पर निशान लगाएँ।</string>
    <string name="account_safety_tip_vehicle">कुछ भी लादने से पहले वाहन और ड्राइवर का विवरण जाँच लें।</string>
    <string name="account_safety_tip_booking_id">सामान केवल आपको दी गई बुकिंग आईडी पर ही सौंपें और उसे पाने वाले के साथ साझा करें।</string>
    <string name="account_safety_tip_code">अपना साइन-इन कोड किसी के साथ साझा न करें, चाहे वह खुद को लोकरथ का बताए।</string>
    <string name="account_safety_tip_valuables">नकदी और क़ीमती सामान को लोड में न रखें।</string>
    <string name="account_safety_tip_prohibited">अवैध, ख़तरनाक या प्रतिबंधित सामान बुक न करें।</string>
    <string name="account_safety_emergency_note">आपातकाल में तुरंत पुलिस, दमकल या एम्बुलेंस सेवाओं से संपर्क करें।</string>
    <string name="account_safety_call">आपातकालीन सेवाओं को कॉल करें (%1$s)</string>

