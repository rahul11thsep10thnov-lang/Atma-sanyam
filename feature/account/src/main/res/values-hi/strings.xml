    <string name="account_delete_title">खाता हटाएँ</string>
    <string name="account_delete_heading">अपना खाता हटाएँ?</string>
    <string name="account_delete_intro">खाता हटाना स्थायी है और वापस नहीं किया जा सकता।</string>
    <string name="account_delete_consequences">निम्नलिखित मिटा दिया जाएगा और आप साइन आउट हो जाएँगे:\n\n• आपकी प्रोफ़ाइल\n• आपके पसंदीदा स्थान\n• आपका बुकिंग इतिहास\n• आपकी सूचनाएँ</string>
    <string name="account_delete_scope_note">लोकरथ का यह संस्करण आपका खाता केवल इसी फ़ोन में रखता है, इसलिए यह उसे इस फ़ोन से मिटाता है। अभी कुछ भी सर्वर पर संग्रहित नहीं है।</string>
    <string name="account_delete_acknowledge">मैं समझता/समझती हूँ कि यह वापस नहीं हो सकता</string>
    <string name="account_delete_button">मेरा खाता हटाएँ</string>
    <string name="account_delete_confirm_title">खाता स्थायी रूप से हटाएँ?</string>
    <string name="account_delete_confirm_message">यह इस फ़ोन से आपके खाते का डेटा मिटा देगा। इसे वापस नहीं किया जा सकता।</string>
    <string name="account_delete_confirm_button">हटाएँ</string>
    <string name="account_delete_failed">खाता नहीं हटाया जा सका। कृपया दोबारा प्रयास करें।</string>

    <string name="account_help_title">सहायता</string>
    <string name="account_help_about_heading">लोकरथ के बारे में</string>
    <string name="account_help_about_body">लोकरथ प्रयागराज की एक सामान और वस्तु डिलीवरी सेवा है। हार्डवेयर, बिजली का सामान, फर्नीचर, उपकरण और बहुत कुछ किसी भी दुकान से आपके दरवाज़े तक पहुँचाने के लिए वाहन बुक करें।</string>
    <string name="account_help_faq_heading">आम सवाल</string>
    <string name="account_help_q_book">डिलीवरी कैसे बुक करूँ?</string>
    <string name="account_help_a_book">पिकअप और गंतव्य दर्ज करें, सामान का विवरण भरें, वाहन चुनें और बुक करें दबाएँ। साइन इन केवल अंतिम चरण में करना होता है।</string>
    <string name="account_help_q_price">कीमत कैसे तय होती है?</string>
    <string name="account_help_a_price">कीमत दूरी, वाहन और आपके सामान पर निर्भर करती है। बुकिंग सारांश में हर शुल्क दिखता है। अंतिम कीमत बुक करने पर पक्की होती है।</string>
    <string name="account_help_q_vehicle">कौन-सा वाहन चुनूँ?</string>
    <string name="account_help_a_vehicle">लोकरथ केवल वही वाहन दिखाता है जो आपके सामान का वज़न और आकार उठा सकें। किराया कम रखने के लिए सबसे छोटा उपयुक्त वाहन चुनें।</string>
    <string name="account_help_q_login">साइन इन कैसे करूँ?</string>
    <string name="account_help_a_login">अपना मोबाइल नंबर दर्ज करें, फिर हमारा भेजा 6 अक्षरों का कोड (अक्षर और अंक) डालें। ईमेल की ज़रूरत नहीं है।</string>
    <string name="account_help_q_language">भाषा कैसे बदलूँ?</string>
    <string name="account_help_a_language">होम स्क्रीन के ऊपर भाषा आइकन दबाएँ और English या हिन्दी चुनें।</string>

