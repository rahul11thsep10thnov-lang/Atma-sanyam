    <string name="ludo_rule_six_to_enter_hint">ఆరు పడితేనే పావు ఇంటి నుంచి బయటకు వస్తుంది.</string>
    <string name="ludo_rule_extra_six">ఆరుకు అదనపు ఆట</string>
