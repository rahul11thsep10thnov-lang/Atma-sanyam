    <!-- Ludo setup (stage 2) -->
    <string name="ludo_intro">మీ నాలుగు పావులను బోర్డు చుట్టూ తిప్పి ఇంటికి చేర్చండి. ఆరు పడితే పావు బయటకు వస్తుంది; ప్రత్యర్థి పావుపై దిగితే అది తన ఇంటికి వెళ్ళిపోతుంది.</string>
    <string name="ludo_house_rules">ఇంటి నియమాలు</string>
