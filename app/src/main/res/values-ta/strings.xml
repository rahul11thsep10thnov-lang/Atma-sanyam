    <!-- Ludo setup (stage 2) -->
    <string name="ludo_intro">உங்கள் நான்கு காய்களையும் பலகையைச் சுற்றி வீட்டுக்குக் கொண்டு வாருங்கள். ஆறு விழுந்தால் காய் வெளியே வரும்; எதிரியின் காய் மீது இறங்கினால் அது அதன் வீட்டுக்குத் திரும்பும்.</string>
    <string name="ludo_house_rules">வீட்டு விதிகள்</string>
    <string name="ludo_rule_six_to_enter">வெளியே வர ஆறு</string>
    <string name="ludo_rule_six_to_enter_hint">ஆறு விழுந்தால் மட்டுமே காய் வீட்டை விட்டு வெளியே வரும்.</string>
    <string name="ludo_rule_extra_six">ஆறுக்கு கூடுதல் உருட்டல்</string>
    <string name="ludo_rule_extra_six_hint">ஆறு விழுந்தால் மீண்டும் உருட்டலாம்; தொடர்ந்து மூன்று ஆறு விழுந்தால் முறை போகும்.</string>
    <string name="ludo_rule_extra_capture">வெட்டினால் கூடுதல் உருட்டல்</string>
    <string name="ludo_rule_extra_capture_hint">எதிரியை வீட்டுக்கு அனுப்பினால் இன்னொரு உருட்டல்.</string>
    <string name="ludo_rule_exact_finish">முடிக்க சரியான எண்</string>
    <string name="ludo_rule_exact_finish_hint">கடைசிக் கட்டத்துக்கு சரியாக அந்த எண் தேவை.</string>
    <string name="ludo_rule_play_on">இடங்களுக்காகத் தொடர்</string>
    <string name="ludo_rule_play_on_hint">முதல் வெற்றியாளருக்குப் பிறகு மற்றவர்கள் 2, 3 இடங்களுக்காக ஆடுவர்.</string>
    <string name="ludo_rules_safe_note">எட்டு நட்சத்திரக் கட்டங்கள் எப்போதும் பாதுகாப்பு: அங்கே வெட்டு இல்லை.</string>
    <string name="ludo_players_two_hint">இரு வீரர்கள் எதிரெதிரே அமர்வர்.</string>
    <string name="ludo_players_three_hint">ஒரு வீடு காலியாக இருக்கும்.</string>
    <string name="ludo_players_four_hint">நான்கு வீடுகளும் நிரம்பும்; காலி இடங்களைக் கணினி ஆடும்.</string>
    <string name="ludo_rules_1">ஒவ்வொரு வீரருக்கும் அவரவர் நிற வீட்டில் நான்கு காய்கள். ஆறு உருட்டி காயை உங்கள் தொடக்கக் கட்டத்துக்குக் கொண்டு வாருங்கள்.</string>
    <string name="ludo_rules_2">விழுந்த எண்ணுக்கு ஏற்ப காயை கடிகார திசையில் நகர்த்துங்கள். எந்தக் காயையும் நகர்த்தலாம்; நகர முடியாத காய் விடப்படும்.</string>
    <string name="ludo_rules_3">சாதாரணக் கட்டத்தில் எதிரியின் காய் மீது இறங்கினால் அது வீட்டுக்குத் திரும்பும். எட்டு நட்சத்திரக் கட்டங்கள் பாதுகாப்பானவை.</string>
    <string name="ludo_rules_4">ஒரு முழு சுற்றுக்குப் பிறகு காய் தன் வீட்டு வரிசையில் திரும்பி, சரியான எண்ணுடன் மையத்தை அடைய வேண்டும்.</string>
    <string name="ludo_rules_5">நான்கு காய்களையும் முதலில் வீட்டுக்குக் கொண்டு வருபவர் வெற்றி; மற்றவர்கள் 2, 3 இடங்களுக்காக ஆடுவர்.</string>
    <string name="board_table_pending">மற்றவர்களுடன் விளையாடுவது லாபி நிலையுடன் வரும். உங்கள் அமைப்புகள் சேமிக்கப்பட்டன.</string>

