    <string name="game_teen_patti_desc">ஏமாற்றி சிறந்த மூன்று சீட்டு கை அமைக்கவும்.</string>
    <string name="game_flush_name">ஃப்ளஷ்</string>
    <string name="game_flush_desc">மூன்று சீட்டுகளின் ஒரு பிராந்திய ஃப்ளஷ் விளையாட்டு.</string>
    <string name="game_coat_piece_name">கோட் பீஸ்</string>
    <string name="game_coat_piece_desc">சீட்டால் கூட்டாளியுடன் சுற்றுகளை வெல்லுங்கள்.</string>
    <string name="game_twenty_nine_name">ட்வென்டி நைன்</string>
    <string name="game_twenty_nine_desc">ஏலம் கூறி, சீட்டு தேர்ந்து, இணையாக சுற்றுகளை வெல்லுங்கள்.</string>
    <string name="game_rummy_name">ரம்மி</string>
    <string name="game_rummy_desc">தொடர்களையும் தொகுப்புகளையும் அமைத்து முதலில் அறிவிக்கவும்.</string>
    <string name="game_dehla_pakad_name">தெஹ்லா பகட்</string>
    <string name="game_dehla_pakad_desc">பத்துகளைப் பிடித்து சுற்றை வெல்லுங்கள்.</string>
    <string name="game_lakadi_name">லக்கடி</string>
    <string name="game_lakadi_desc">பிராந்திய முறையில் சீட்டு சுற்றுகள்.</string>
    <string name="game_solitaire_name">சாலிடேர்</string>
    <string name="game_solitaire_desc">ஒவ்வொரு சீட்டாக அகற்றி பலகையை சுத்தம் செய்யவும்.</string>
    <string name="game_spider_solitaire_name">ஸ்பைடர் சாலிடேர்</string>
    <string name="game_spider_solitaire_desc">ஒவ்வொரு நெடுவரிசையிலும் முழு தொடரை அமைக்கவும்.</string>

