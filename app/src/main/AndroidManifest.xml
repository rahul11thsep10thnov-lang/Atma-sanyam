<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed from Phase 12 onward for backend calls; Maps/Places location permissions are
         added in Phase 3-4 alongside the runtime permission-request flow (never requested at
         launch - see requirement 35). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".AtmaSanyamApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AtmaSanyam">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AtmaSanyam">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets AppCompat remember the language picked in the in-app menu on Android 8-12
             (Android 13+ stores it in the system itself). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Read by the Google Maps SDK at runtime. Empty/missing until secrets.properties
             supplies a real MAPS_API_KEY (see README) - the app still builds and runs without
             one, the map just can't load tiles yet. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />
    </application>

</manifest>
