# Copy to .env. Never commit real secrets.
CSAE_ENV=development
CSAE_DATABASE_URL=postgresql+psycopg://csae:csae-dev@localhost:5432/csae_dev
# Required when CSAE_ENV is not development/test:  python -c "import secrets; print(secrets.token_urlsafe(48))"
CSAE_JWT_SECRET=
CSAE_CORS_ORIGINS=http://localhost:5173
# Voice provider: espeak (local, default) | sarvam (needs CSAE_SARVAM_API_KEY)
CSAE_VOICE_PROVIDER=espeak
CSAE_SARVAM_API_KEY=
# Story analysis: none (built-in rule-based analyser) | anthropic (needs ANTHROPIC_API_KEY)
CSAE_LLM_PROVIDER=none
ANTHROPIC_API_KEY=
