{
  "name": "budgettourism",
  "version": "0.1.0",
  "private": true,
  "description": "budgettourism — Discover India, Better. An India-focused tourism encyclopedia and travel-advisory platform.",
  "scripts": {
    "postinstall": "prisma generate || echo 'Skipping prisma generate (no DATABASE_URL / offline) — run npm run prisma:generate once configured.'",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "verify:engine": "tsx --tsconfig tsconfig.seed.json scripts/verify-engine.ts",
    "test:discovery": "tsx --tsconfig tsconfig.seed.json scripts/test-discovery.ts",
    "verify:seed-types": "tsc --noEmit -p tsconfig.seed.json",
    "enrich:seed": "tsx --tsconfig tsconfig.seed.json scripts/enrich-seed.ts",
    "import:master": "tsx --tsconfig tsconfig.seed.json scripts/import-master.ts",
    "import:facts": "tsx --tsconfig tsconfig.seed.json scripts/import-facts.ts",
    "translate": "tsx --tsconfig tsconfig.seed.json scripts/translate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@prisma/client": "^5.20.0",
    "exceljs": "^4.4.0",
    "next": "14.2.15",
    "next-auth": "^4.24.7",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.40",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
